@{
    ViewData["Title"] = "AT31AuditMasterLogBook";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>AT 3.1 Audit Master Log Book</h1>
    <div class="d-flex align-items-center">
        <label class="fw-bold me-2 mb-0">Report as At</label>
        <input type="date" id="reportAsAt" class="form-control form-control-sm" style="width: 160px;" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-tasks me-2"></i>Audit Master Log Book Records
                </h3>
            </div>
            <div class="card-body" style="overflow:auto">
                <table id="taskDatatable" class="table table-bordered table-striped align-middle text-nowrap text-center" style="width:100%">
                    <thead>
                        <!-- Row 1: Super Header -->
                        <tr>
                            <th rowspan="2" class="align-middle">No</th>
                            <th rowspan="2" class="align-middle">Company Name</th>
                            <th rowspan="2" class="align-middle">Activity</th>
                            <th rowspan="2" class="align-middle">YE to do</th>
                            <th rowspan="2" class="align-middle">Qtr to</th>
                            <th rowspan="2" class="align-middle">PIC</th>
                            <th rowspan="2" class="align-middle">Status</th>
                            <th rowspan="2" class="align-middle">Doc.Inwards Date</th>
                            <th colspan="2" class="text-center">Current yr result '000</th>
                            <th colspan="2" class="text-center">Billing</th>
                            <th colspan="9" class="text-center">1. Audit WIP</th>
                            <th colspan="5" class="text-center">2. Audit Report AFS</th>
                            <th colspan="3" class="text-center">3. Directors Signing Pages</th>
                            <th colspan="3" class="text-center">4. Tax Dept</th>
                            <th colspan="2" class="text-center">5. Sec Dept</th>
                            <th colspan="1" class="text-center">6. Post Audit Work</th>
                            <th rowspan="2" class="align-middle">Actions</th>
                        </tr>
                        <!-- Row 2: Sub Header -->
                        <tr>
                            <!-- Current yr result '000 -->
                            <th>Revenue</th>
                            <th>Profit/(loss)</th>
                            <!-- Billing -->
                            <th>Audit Fee</th>
                            <th>Date billed</th>
                            <!-- 1. Audit WIP -->
                            <th>Start Date 1.1</th>
                            <th>Date End 1.2</th>
                            <th>Days Done 1.3</th>
                            <th>%Done 1.4</th>
                            <th>Completed? 1.5</th>
                            <th>Total Field Work Days</th>
                            <th>Date sent 1.6</th>
                            <th>End Date 1.7</th>
                            <th># of days 1.8</th>
                            <!-- 2. Audit Report AFS -->
                            <th>Date sent to KK 2.1</th>
                            <th>Review result(Final)# of days 2.2</th>
                            <th># of days 2.3</th>
                            <th>Date Received</th>
                            <th>Total review Days 2.4</th>
                            <!-- 3. Directors Signing Pages -->
                            <th>Client Meeting By 3.1</th>
                            <th>Date Sent to Client 3.2</th>
                            <th>Date Received Back 3.3</th>
                            <!-- 4. Tax Dept -->
                            <th>Target Tax Work Date 4.1</th>
                            <th>Date Pass to Tax Dept 4.2</th>
                            <th>Metric (4.2-4.1)</th>
                            <!-- 5. Sec Dept -->
                            <th>SSM Due Date</th>
                            <th>Date pass to Sec (MBRS)</th>
                            <!-- 6. Post Audit Work -->
                            <th>Binded</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_DatatablesB5ScriptsPartial" />

    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

    <script>
        let dataTable = null;

        $(document).ready(function () {
            loadData();
        });

        function initializeDataTable() {
            if ($.fn.DataTable.isDataTable('#taskDatatable')) {
                dataTable.destroy();
            }
            dataTable = $('#taskDatatable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": false,
                "scrollX": true,
                "dom": 'Bfrtip',
                "buttons": [
                    { extend: 'copy', text: 'Copy' },
                    { extend: 'csv', text: 'CSV' },
                    { extend: 'excel', text: 'Excel' },
                    { extend: 'pdf', text: 'PDF' },
                    { extend: 'print', text: 'Print' },
                    { extend: 'colvis', text: 'Column visibility' }
                ],
                "language": {
                    "emptyTable": "No audit master log book records found",
                    "loadingRecords": "Loading...",
                    "zeroRecords": "No matching records found"
                }
            });
        }

        function loadData() {
            const tbody = $('#tableBody');
            if ($.fn.DataTable.isDataTable('#taskDatatable')) {
                $('#taskDatatable').DataTable().destroy();
            }
            tbody.html('<tr><td colspan="36" class="text-center">Loading data...</td></tr>');
            $.ajax({
                url: '/api/auditdept/at31/get-all',
                type: 'GET',
                success: function (response) {
                    if (response.success && response.data) {
                        populateTable(response.data);
                    } else {
                        tbody.html('<tr><td colspan="36" class="text-center">No data available</td></tr>');
                        initializeDataTable();
                    }
                },
                error: function (xhr, status, error) {
                    tbody.html('<tr><td colspan="36" class="text-center">Error loading data</td></tr>');
                    showAlert('Error loading data: ' + error, 'danger');
                }
            });
        }

        function populateTable(data) {
            const tbody = $('#tableBody');
            tbody.empty();
            if (data && data.length > 0) {
                data.forEach(function (item, index) {
                    // Formula: Metric 4.2-4.1
                    let metricVal = item.metric421 || '';
                    if (!metricVal && item.passtoDept && item.taxDueDate) {
                        const d1 = new Date(item.taxDueDate);
                        const d2 = new Date(item.passtoDept);
                        if (!isNaN(d1.getTime()) && !isNaN(d2.getTime())) {
                            const diffDays = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
                            metricVal = diffDays + ' days';
                        }
                    }

                    // Formula: Total Field Work Days = 1.3 + 2.3
                    const daysDoneVal = parseFloat(item.daysDone) || 0;
                    const days23Val = parseFloat(item.reviewResultofDays) || 0;
                    const totalFieldWorkDays = (item.daysDone || item.reviewResultofDays) ? (daysDoneVal + days23Val) : '';

                    const row = `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${escapeHtml(item.companyName || '')}</td>
                            <td>${escapeHtml(item.activity || '')}</td>
                            <td>${escapeHtml(item.yEtoDo || '')}</td>
                            <td>${escapeHtml(item.quartertoDo || '')}</td>
                            <td>${escapeHtml(item.pic || '')}</td>
                            <td>${escapeHtml(item.status || '')}</td>
                            <td>${formatDate(item.docInwardsDate)}</td>
                            <td>${formatNumber(item.revenue)}</td>
                            <td>${formatNumber(item.profit)}</td>
                            <td>${formatNumber(item.auditFee)}</td>
                            <td>${formatDate(item.dateBilled)}</td>
                            <td>${formatDate(item.startDate)}</td>
                            <td>${formatDate(item.endDate)}</td>
                            <td>${item.daysDone || ''}</td>
                            <td>${formatPercentage(item.donePercent)}</td>
                            <td>${escapeHtml(item.completed || '')}</td>
                            <td>${totalFieldWorkDays}</td>
                            <td>${formatDate(item.dateSent1_6)}</td>
                            <td>${formatDate(item.endDate1_7)}</td>
                            <td>${item.days1_8 || ''}</td>
                            <td>${formatDate(item.dateSentToKK)}</td>
                            <td>${escapeHtml(item.reviewResultofDays || '')}</td>
                            <td>${escapeHtml(item.reviewResultofDays || '')}</td>
                            <td>${formatDate(item.dateReceiveFromKK)}</td>
                            <td>${item.totalReviewDays || ''}</td>
                            <td>${escapeHtml(item.whoMeetClientDate || '')}</td>
                            <td>${formatDate(item.dateSenttoClient)}</td>
                            <td>${formatDate(item.dateReceiveBack)}</td>
                            <td>${formatDate(item.taxDueDate)}</td>
                            <td>${formatDate(item.passtoDept)}</td>
                            <td>${metricVal}</td>
                            <td>${formatDate(item.ssMdueDate)}</td>
                            <td>${formatDate(item.datePasstoSecDept)}</td>
                            <td>${escapeHtml(item.binded || '')}</td>
                            <td>
                                <button class="btn btn-sm btn-danger" onclick="deleteRecord(${item.id})" title="Delete"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            }
            initializeDataTable();
        }

        function deleteRecord(id) {
            if (confirm('Are you sure you want to delete this record?')) {
                $.ajax({
                    url: '/api/auditdept/at31/delete/' + id,
                    type: 'DELETE',
                    success: function (response) {
                        if (response.success) {
                            showAlert('Record deleted successfully!', 'success');
                            loadData();
                        } else {
                            showAlert('Error deleting record: ' + response.message, 'danger');
                        }
                    },
                    error: function (xhr, status, error) {
                        showAlert('Error deleting record: ' + error, 'danger');
                    }
                });
            }
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            try {
                const date = new Date(dateString);
                return isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-GB');
            } catch (e) { return ''; }
        }

        function formatNumber(value) {
            if (value === null || value === undefined || value === '') return '';
            const num = parseFloat(value);
            return isNaN(num) ? '' : num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function formatPercentage(value) {
            if (value === null || value === undefined || value === '') return '';
            const num = parseFloat(value);
            return isNaN(num) ? '' : num.toFixed(1) + '%';
        }

        function escapeHtml(unsafe) {
            if (!unsafe) return '';
            return unsafe.toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function showAlert(message, type) {
            const alertClass = `alert alert-${type} alert-dismissible fade show`;
            const alertHtml = `<div class="${alertClass}" role="alert">${message}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>`;
            $('.alert').remove();
            $('.card-body').prepend(alertHtml);
            setTimeout(() => { $('.alert').alert('close'); }, 5000);
        }
    </script>
}
