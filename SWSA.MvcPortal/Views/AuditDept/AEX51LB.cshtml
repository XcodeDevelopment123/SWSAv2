@{
    ViewData["Title"] = "AEX51LB";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>AEX Audit Logbook</h1>
    <div class="d-flex align-items-center">
        <label class="fw-bold me-2 mb-0">Report as At</label>
        <input type="date" id="reportAsAt" class="form-control form-control-sm" style="width: 160px;" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-tasks me-2"></i>AEX Audit Logbook Records
                </h3>
            </div>
            <div class="card-body" style="overflow:auto">
                <table id="taskDatatable" class="table table-bordered table-striped align-middle text-nowrap text-center" style="width:100%">
                    <thead>
                        <tr>
                            <th colspan="12" class="text-center bg-white">Basic Info & Billing</th>
                            <th colspan="4" class="text-center bg-white">1. Audit WIP</th>
                            <th colspan="2" class="text-center bg-white">2. Audit Report</th>
                            <th colspan="4" class="text-center bg-white">3. Directors' Signing & Client</th>
                            <th colspan="3" class="text-center bg-white">4. Tax Dept</th>
                            <th colspan="2" class="text-center bg-white">5. Sec Dept</th>
                            <th colspan="1" class="text-center bg-white">6. Post Audit Work</th>
                            <th rowspan="2" class="align-middle bg-white">Action</th>
                        </tr>
                        <tr>
                            <th>No</th>
                            <th>Company Name</th>
                            <th>Activity</th>
                            <th>YE to do</th>
                            <th>Quarter to do</th>
                            <th>PIC</th>
                            <th>Status</th>
                            <th>Doc.Inward Date</th>
                            <th>Revenue</th>
                            <th>Profit/(loss)</th>
                            <th>Audit Fee</th>
                            <th>Date billed</th>

                            <th>Start Date</th>
                            <th>End</th>
                            <th>Days</th>
                            <th>Total Field Works Days</th>

                            <th>Date Start</th>
                            <th>End</th>

                            <th># of</th>
                            <th>Date of Report</th>
                            <th>Date sent to client</th>
                            <th>Date Received Back</th>

                            <th>Target Tax Work Date</th>
                            <th>Date Pass to Tax Dept</th>
                            <th>Metric</th>

                            <th>SSM Due Date</th>
                            <th>Date Pass to Sec (MBRS)</th>

                            <th>Binded?</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_DatatablesB5ScriptsPartial" />
    
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

    <script>
        let dataTable = null;

        $(document).ready(function() {
            loadData();
        });

        function initializeDataTable() {
            if ($.fn.DataTable.isDataTable('#taskDatatable')) {
                dataTable.destroy();
            }
            dataTable = $('#taskDatatable').DataTable({
                "paging": true,
                "lengthChange": true,
                "searching": true,
                "ordering": true,
                "info": true,
                "autoWidth": false,
                "responsive": false,
                "scrollX": true,
                "dom": 'Bfrtip',
                "buttons": [
                    { extend: 'copy', text: 'Copy' },
                    { extend: 'csv', text: 'CSV' },
                    { extend: 'excel', text: 'Excel' },
                    { extend: 'pdf', text: 'PDF' },
                    { extend: 'print', text: 'Print' },
                    { extend: 'colvis', text: 'Column visibility' }
                ],
                "language": {
                    "emptyTable": "No AEX audit logbook records found",
                    "loadingRecords": "Loading...",
                    "zeroRecords": "No matching records found"
                }
            });
        }

        function loadData() {
            const tbody = $('#tableBody');
            if ($.fn.DataTable.isDataTable('#taskDatatable')) {
                $('#taskDatatable').DataTable().destroy();
            }
            tbody.html('<tr><td colspan="29" class="text-center">Loading data...</td></tr>');
            $.ajax({
                url: '/api/auditdept/aex51/get-all',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        populateTable(response.data);
                    } else {
                        tbody.html('<tr><td colspan="29" class="text-center">No data available</td></tr>');
                        initializeDataTable();
                    }
                },
                error: function(xhr, status, error) {
                    tbody.html('<tr><td colspan="29" class="text-center">Error loading data</td></tr>');
                    showAlert('Error loading data: ' + error, 'danger');
                }
            });
        }

        function populateTable(data) {
            const tbody = $('#tableBody');
            tbody.empty();
            if (data && data.length > 0) {
                data.forEach(function(item, index) {
                    // Formula 4.2 - 4.1 (Date Pass to Tax Dept - Target Tax Work Date)
                    let metricVal = item.metric421 || '';
                    if (!metricVal && item.datePassTaxDept42 && item.targetTaxWorkDate41) {
                        const d1 = new Date(item.targetTaxWorkDate41);
                        const d2 = new Date(item.datePassTaxDept42);
                        if (!isNaN(d1.getTime()) && !isNaN(d2.getTime())) {
                            const diffDays = Math.round((d2 - d1) / (1000 * 60 * 60 * 24));
                            metricVal = diffDays + ' days';
                        }
                    }

                    // Formula 1.4: Total Field Works Days = Days 1.3 + # of 2.3
                    const days13Val = parseFloat(item.days1_3) || 0;
                    const hash23Val = parseFloat(item.hashOf23) || 0;
                    const totalFieldWorksDays = (item.days1_3 || item.hashOf23) ? (days13Val + hash23Val) : (item.totalFieldWorksDays1_4 || '');

                    const row = `
                        <tr>
                            <td>${index + 1}</td>
                            <td>${escapeHtml(item.companyName || '')}</td>
                            <td>${escapeHtml(item.activity || '')}</td>
                            <td>${escapeHtml(item.yEtoDo || '')}</td>
                            <td>${escapeHtml(item.quartertoDo || '')}</td>
                            <td>${escapeHtml(item.pic || '')}</td>
                            <td>${escapeHtml(item.status || '')}</td>
                            <td>${formatDate(item.docInwardDate)}</td>
                            <td>${formatNumber(item.revenue)}</td>
                            <td>${formatNumber(item.profit)}</td>
                            <td>${formatNumber(item.auditFee)}</td>
                            <td>${formatDate(item.dateBilled)}</td>
                            <td>${formatDate(item.startDate)}</td>
                            <td>${formatDate(item.end1_2)}</td>
                            <td>${item.days1_3 || ''}</td>
                            <td><strong class="text-primary">${totalFieldWorksDays}</strong></td>
                            <td>${formatDate(item.dateStart21)}</td>
                            <td>${formatDate(item.end22)}</td>
                            <td>${item.hashOf23 || ''}</td>
                            <td>${formatDate(item.dateOfReport31)}</td>
                            <td>${formatDate(item.dateSentToClient)}</td>
                            <td>${formatDate(item.dateReceivedBack)}</td>
                            <td>${formatDate(item.targetTaxWorkDate41)}</td>
                            <td>${formatDate(item.datePassTaxDept42)}</td>
                            <td>${metricVal}</td>
                            <td>${formatDate(item.ssmDueDate)}</td>
                            <td>${formatDate(item.datePassToSecMBRS52)}</td>
                            <td>${escapeHtml(item.binded || item.blinded || '')}</td>
                            <td>
                                <button class="btn btn-sm btn-danger" onclick="deleteRecord(${item.id})" title="Delete"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            }
            initializeDataTable();
        }

        function deleteRecord(id) {
            if (confirm('Are you sure you want to delete this record?')) {
                $.ajax({
                    url: '/api/auditdept/aex51/delete/' + id,
                    type: 'DELETE',
                    success: function(response) {
                        if (response.success) {
                            showAlert('Record deleted successfully!', 'success');
                            loadData();
                        } else {
                            showAlert('Error deleting record: ' + response.message, 'danger');
                        }
                    },
                    error: function(xhr, status, error) {
                        showAlert('Error deleting record: ' + error, 'danger');
                    }
                });
            }
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            try {
                const date = new Date(dateString);
                return isNaN(date.getTime()) ? '' : date.toLocaleDateString('en-GB');
            } catch (e) { return ''; }
        }

        function formatNumber(value) {
            if (value === null || value === undefined || value === '') return '';
            const num = parseFloat(value);
            return isNaN(num) ? '' : num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function escapeHtml(unsafe) {
            if (!unsafe) return '';
            return unsafe.toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function showAlert(message, type) {
            const alertClass = `alert alert-${type} alert-dismissible fade show`;
            const alertHtml = `<div class="${alertClass}" role="alert">${message}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>`;
            $('.alert').remove();
            $('.card-body').prepend(alertHtml);
            setTimeout(() => { $('.alert').alert('close'); }, 5000);
        }
    </script>
}
