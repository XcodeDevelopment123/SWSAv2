@{
    ViewData["Title"] = "Audit Aex Backlog";
}

<style>
    /* Column Visibility dropdown: fixed height, both scroll directions like reference */
    .dt-button-collection {
        z-index: 99999 !important;
        max-height: 350px !important;
        overflow-y: auto !important;    /* vertical scrollbar on right */
        overflow-x: auto !important;    /* horizontal scrollbar on bottom */
        background: #fff;
    }

    .dt-button-background {
        z-index: 99998 !important;
        pointer-events: none !important;
    }
</style>

<h1>E3.2 AEX Audit Backlog</h1>

<div class="row">
    <div class="col-md-12">
        <!-- /.card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-tasks me-2"></i>Audit AEX Backlog Records
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#taskModal" onclick="clearForm()">
                        <i class="fas fa-plus me-2"></i>New Record
                    </button>
                </div>
            </div>
            <!-- /.card-header -->
            <div class="card-body" style="overflow:auto">
                <table id="taskDatatable" class="table table-bordered table-striped" style="width:100%">
                    <thead>
                        <tr>
                            <th>Actions</th>
                            <th>Group</th>
                            <th>Company Name</th>
                            <th>Quarter to Do Audit</th>
                            <th>Activity</th>
                            <th>Co. Status</th>
                            <th>Audit Exemption</th>
                            <th>Co. Sec</th>
                            <th>Credit Rating</th>
                            <th>Signing Firm</th>
                            <th>Year End</th>
                            <th>Year to do</th>
                            <th>Move to Active Sch</th>
                            <th>Date Doc in</th>
                            <th>Acctng wk?</th>
                            <th>Reason why backlog</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be populated via DataTable -->
                    </tbody>
                </table>
            </div>
            <!-- /.card-body -->
        </div>
        <!-- /.card -->
    </div>
</div>

<!-- 模态框部分 -->
<div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskModalLabel">
                    <i class="fas fa-edit me-2"></i>
                    <span id="modalTitle">Add New AEX Audit Backlog Record</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="taskForm">
                    <input type="hidden" id="recordId" value="">
                    <input type="hidden" id="companyName" name="companyName" value="">
                    <input type="hidden" id="clientId" name="clientId" value="">

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="grouping">Group</label>
                                <input type="text" id="grouping" name="grouping" class="form-control" placeholder="Auto Fill" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="clientSelect">Company Name <span class="text-danger">*</span></label>
                                <select id="clientSelect" name="clientSelect" class="form-control" required style="width:100%">
                                    <option value="">-- Select Company from Client List --</option>
                                </select>
                                <small class="text-muted">Linked from Client List</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="quarterToDoAudit">Quarter to Do Audit</label>
                                <select id="quarterToDoAudit" name="quarterToDoAudit" class="form-control">
                                    <option value="">Select Quarter</option>
                                    <option value="1st Qtr">1st Qtr</option>
                                    <option value="2nd Qtr">2nd Qtr</option>
                                    <option value="3rd Qtr">3rd Qtr</option>
                                    <option value="4th Qtr">4th Qtr</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="activity">Activity</label>
                                <input type="text" id="activity" name="activity" class="form-control" placeholder="Auto Fill" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="companyStatus">Co. Status</label>
                                <input type="text" id="companyStatus" name="companyStatus" class="form-control" placeholder="Auto Fill" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="auditExemption">Audit Exemption</label>
                                <input type="text" id="auditExemption" name="auditExemption" class="form-control" placeholder="Auto Fill" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="coSec">Co. Sec</label>
                                <input type="text" id="coSec" name="coSec" class="form-control" placeholder="Auto Fill" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="creditRating">Credit Rating</label>
                                <input type="text" id="creditRating" name="creditRating" class="form-control" placeholder="Auto Fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="signingFirm">Signing Firm</label>
                                <input type="text" id="signingFirm" name="signingFirm" class="form-control" placeholder="Auto Fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="yearEnd">Year End</label>
                                <input type="text" id="yearEnd" name="yearEnd" class="form-control" placeholder="Auto Fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="yearToDo">Year to do</label>
                                <select id="yearToDo" name="yearToDo" class="form-control">
                                    <option value="">Select Year</option>
                                    @for (int year = 2020; year <= 2050; year++)
                                    {
                                        <option value="@year">@year</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="moveToActiveSch">Move to Active Sch</label>
                                <select id="moveToActiveSch" name="moveToActiveSch" class="form-control">
                                    <option value="">Select</option>
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="dateDocIn">Date Doc in</label>
                                <input type="date" id="dateDocIn" name="dateDocIn" class="form-control" />
                                <small class="text-muted">Link from C1-1 Inward Doc</small>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="acctngWk">Acctng wk?</label>
                                <input type="text" id="acctngWk" name="acctngWk" class="form-control" placeholder="Auto Fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="reasonWhyBacklog">Reason why backlog</label>
                                <input type="text" id="reasonWhyBacklog" name="reasonWhyBacklog" class="form-control" placeholder="Enter reason" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveBtn">
                    <i class="fas fa-save me-2"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- DataTables CSS + JS (Bootstrap 5 integration, same partial as other pages
         so Buttons / Column visibility render with identical styling) -->
    <partial name="_DatatablesScriptsPartial" />

    <script>
        let dataTable = null;
        let currentEditId = null;
        let clientNameMap = {};
        let clientDataMap = {};

        $(document).ready(function() {
            initializeDataTable();
            loadClientOptions(function() {
                loadData();
            });

            $('#clientSelect').on('change', function() {
                handleClientChange($(this).val());
            });

            // 保存按钮点击事件
            $('#saveBtn').click(function() {
                saveRecord();
            });

            // DataTables injects an inline max-height on the collection panel.
            // Override it with our desired value so both scrollbars show correctly.
            var dtCollectionObserver = new MutationObserver(function(mutations) {
                mutations.forEach(function(m) {
                    if (!m.addedNodes) return;
                    m.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1 && node.classList && node.classList.contains('dt-button-collection')) {
                            node.style.setProperty('max-height', '350px', 'important');
                            node.style.setProperty('overflow-y', 'auto', 'important');
                            node.style.setProperty('overflow-x', 'auto', 'important');
                            node.style.setProperty('z-index', '99999', 'important');
                        }
                    });
                });
            });
            dtCollectionObserver.observe(document.body, { childList: true, subtree: true });
        });

        function loadClientOptions(callback) {
            $.ajax({
                url: '/api/get/company-options',
                type: 'GET',
                success: function(response) {
                    if (response.success && response.data) {
                        const select = $('#clientSelect');
                        select.empty();
                        select.append('<option value="">-- Select Company from Client List --</option>');

                        clientNameMap = {};
                        clientDataMap = {};

                        response.data.forEach(client => {
                            if (client.companyName) {
                                clientNameMap[client.companyName.trim()] = client.id;
                            }
                            clientDataMap[client.id] = client;
                            select.append(`<option value="${client.id}">${escapeHtml(client.companyName)}</option>`);
                        });

                        if ($.fn.select2) {
                            select.select2({
                                theme: 'bootstrap4',
                                placeholder: '-- Select Company from Client List --',
                                allowClear: true,
                                dropdownParent: $('#taskModal .modal-content'),
                                width: '100%'
                            });
                        }
                    }
                    if (typeof callback === 'function') callback();
                },
                error: function(xhr, status, error) {
                    console.error('Error loading client options:', error);
                    if (typeof callback === 'function') callback();
                }
            });
        }

        function handleClientChange(selectedId) {
            const clientData = clientDataMap[selectedId];

            if (clientData) {
                $('#grouping').val(clientData.grouping || '');
                $('#companyName').val(clientData.companyName || '');
                $('#clientId').val(clientData.id || '');

                // Auto fill Activity
                if (clientData.activitySize) {
                    $('#activity').val(clientData.activitySize);
                }

                // Auto fill Company Status, Audit Exemption, Credit Rating
                if (clientData.companyStatus) {
                    $('#companyStatus').val(clientData.companyStatus);
                }
                if (clientData.auditExemption) {
                    $('#auditExemption').val(clientData.auditExemption);
                }
                if (clientData.creditRating) {
                    $('#creditRating').val(clientData.creditRating);
                }

                // Auto fill Year End and default Year to do
                if (clientData.yearEndMonth) {
                    const calculatedDate = calculateYearEndDate(clientData.yearEndMonth);
                    $('#yearEnd').val(calculatedDate);
                    if (!$('#yearToDo').val() && calculatedDate) {
                        const parts = calculatedDate.split('/');
                        if (parts.length === 3) {
                            $('#yearToDo').val(parts[2]);
                        }
                    }
                } else {
                    $('#yearEnd').val('');
                }

                // Auto fill Co. Sec & Signing Firm from Appointment Data
                let coSecVal = 'No';
                let signingFirmVal = '';
                if (clientData.appointmentEngagementData) {
                    try {
                        const apptData = typeof clientData.appointmentEngagementData === 'string'
                            ? JSON.parse(clientData.appointmentEngagementData)
                            : clientData.appointmentEngagementData;

                        const hasCoSec = (apptData.linkE22 && apptData.linkE22.coSecretary === true);
                        const hasSecDate = (apptData.appointments && apptData.appointments.Sec && apptData.appointments.Sec.appointmentDate);

                        if (hasCoSec || hasSecDate) {
                            coSecVal = 'Yes';
                        }
                        if (apptData.appointments && apptData.appointments.Audit && apptData.appointments.Audit.signingFirm) {
                            signingFirmVal = apptData.appointments.Audit.signingFirm;
                        } else if (apptData.linkE1 && apptData.linkE1.who) {
                            signingFirmVal = apptData.linkE1.who;
                        }
                    } catch (e) {
                        console.error('Error parsing appointmentEngagementData in E3.2:', e);
                    }
                }
                $('#coSec').val(coSecVal);
                $('#signingFirm').val(signingFirmVal || clientData.signingFirm || '');

                // Auto fill Acctng wk? from B1 serviceSelected
                let hasAcc = false;
                if (clientData.serviceSelected) {
                    const services = clientData.serviceSelected.split(',').map(s => s.trim().toLowerCase());
                    hasAcc = services.includes('acc');
                }
                $('#acctngWk').val(hasAcc ? 'Yes' : 'No');

                // Auto fill Date Doc in from C1-1 Inward Doc (A31A) if available
                if (clientData.latestDateDocIn) {
                    const isoDate = formatIsoForDateInput(clientData.latestDateDocIn);
                    if (isoDate) {
                        $('#dateDocIn').val(isoDate);
                    }
                }
            } else {
                $('#grouping').val('');
                $('#companyName').val('');
                $('#clientId').val('');
                $('#activity').val('');
                $('#companyStatus').val('');
                $('#auditExemption').val('');
                $('#creditRating').val('');
                $('#yearEnd').val('');
                $('#yearToDo').val('');
                $('#coSec').val('');
                $('#signingFirm').val('');
                $('#acctngWk').val('');
                $('#dateDocIn').val('');
            }
        }

        function calculateYearEndDate(monthName) {
            if (!monthName) return '';
            const months = {
                "january": 0, "february": 1, "march": 2, "april": 3, "may": 4, "june": 5,
                "july": 6, "august": 7, "september": 8, "october": 9, "november": 10, "december": 11
            };
            const cleanName = monthName.trim().toLowerCase();
            const monthIndex = months[cleanName];

            if (monthIndex === undefined) return '';

            const currentYear = new Date().getFullYear();
            const date = new Date(currentYear, monthIndex + 1, 0);

            const dd = String(date.getDate()).padStart(2, '0');
            const mm = String(date.getMonth() + 1).padStart(2, '0');
            const yyyy = date.getFullYear();
            return `${dd}/${mm}/${yyyy}`;
        }

        function formatIsoForDateInput(dateStr) {
            if (!dateStr) return '';
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return dateStr;
                const yyyy = d.getFullYear();
                const mm = String(d.getMonth() + 1).padStart(2, '0');
                const dd = String(d.getDate()).padStart(2, '0');
                return `${yyyy}-${mm}-${dd}`;
            } catch (e) {
                return '';
            }
        }

        function initializeDataTable() {
            if ($.fn.DataTable.isDataTable('#taskDatatable')) {
                $('#taskDatatable').DataTable().destroy();
            }

            dataTable = $('#taskDatatable').DataTable({
                paging: true,
                lengthChange: true,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                responsive: false,
                scrollX: true,
                dom: '<"d-flex justify-content-between align-items-center mb-2"Bf>rtip',
                buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"],
                language: {
                    search: "Search:",
                    emptyTable: "No audit AEX backlog records found",
                    loadingRecords: "Loading...",
                    zeroRecords: "No matching records found",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "Showing 0 to 0 of 0 entries"
                },
                columns: [
                    {
                        data: null,
                        render: function(data, type, row) {
                            return `
                                <button class="btn btn-sm btn-warning me-1" onclick="editRecord(${row.id})" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" onclick="deleteRecord(${row.id})" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            `;
                        },
                        orderable: false,
                        searchable: false
                    },
                    { data: "grouping" },
                    { data: "companyName" },
                    { data: "quarterToDoAudit" },
                    { data: "activity" },
                    { data: "companyStatus" },
                    { data: "auditExemption" },
                    { data: "coSec" },
                    { data: "creditRating" },
                    { data: "signingFirm" },
                    { data: "yearEnd" },
                    { data: "yearToDo" },
                    { data: "moveToActiveSch" },
                    {
                        data: "dateDocIn",
                        render: function(data) { return formatDate(data); }
                    },
                    { data: "acctngWk" },
                    { data: "reasonWhyBacklog" }
                ]
            });
        }

        function loadData() {
            $.ajax({
                url: '/api/auditdept/aex42/get-all',
                type: 'GET',
                cache: false,
                success: function(response) {
                    if (response.success && response.data) {
                        populateTable(response.data);
                    } else {
                        console.error('Error loading data:', response.message);
                        if (dataTable) dataTable.clear().draw();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading data:', error);
                    if (dataTable) dataTable.clear().draw();
                }
            });
        }

        function populateTable(data) {
            if (data && data.length > 0) {
                const formattedData = data.map(function(item) {
                    const compName = (item.companyName || item.CompanyName || '').trim();
                    const client = clientDataMap[clientNameMap[compName]] || {};

                    // 从 client 解析 coSec / signingFirm / auditExemption
                    let clientCoSec = client.coSec || '';
                    let clientSigningFirm = client.signingFirm || '';
                    let clientAuditExemption = client.auditExemption || '';

                    if (client.appointmentEngagementData) {
                        try {
                            const apptData = typeof client.appointmentEngagementData === 'string'
                                ? JSON.parse(client.appointmentEngagementData)
                                : client.appointmentEngagementData;

                            const hasCoSec = (apptData.linkE22 && apptData.linkE22.coSecretary === true);
                            const hasSecDate = (apptData.appointments && apptData.appointments.Sec && apptData.appointments.Sec.appointmentDate);
                            if (hasCoSec || hasSecDate) clientCoSec = 'Yes';
                            else if (!clientCoSec) clientCoSec = 'No';

                            if (apptData.appointments && apptData.appointments.Audit && apptData.appointments.Audit.signingFirm) {
                                clientSigningFirm = apptData.appointments.Audit.signingFirm;
                            } else if (apptData.linkE1 && apptData.linkE1.who) {
                                clientSigningFirm = apptData.linkE1.who;
                            }
                        } catch (e) {}
                    }

                    return {
                        id: item.id || item.Id,
                        grouping: escapeHtml(item.grouping || item.Grouping || client.grouping || ''),
                        companyName: escapeHtml(compName),
                        quarterToDoAudit: escapeHtml(item.quarterToDoAudit || item.QuarterToDoAudit || ''),
                        activity: escapeHtml(item.activity || item.Activity || client.activitySize || client.activity || ''),
                        companyStatus: escapeHtml(item.companyStatus || item.CompanyStatus || client.companyStatus || ''),
                        auditExemption: escapeHtml(item.auditExemption || item.AuditExemption || clientAuditExemption || ''),
                        coSec: escapeHtml(item.coSec || item.CoSec || clientCoSec || ''),
                        creditRating: escapeHtml(item.creditRating || item.CreditRating || client.creditRating || ''),
                        signingFirm: escapeHtml(item.signingFirm || item.SigningFirm || clientSigningFirm || ''),
                        yearEnd: escapeHtml(item.yearEnd || item.YearEnd || ''),
                        yearToDo: escapeHtml(item.yearToDo || item.YearToDo || ''),
                        moveToActiveSch: escapeHtml(item.moveToActiveSch || item.MoveToActiveSch || ''),
                        dateDocIn: item.dateDocIn || item.DateDocIn,
                        acctngWk: escapeHtml(item.acctngWk || item.AcctngWk || ''),
                        reasonWhyBacklog: escapeHtml(item.reasonWhyBacklog || item.ReasonWhyBacklog || '')
                    };
                });

                dataTable.clear();
                dataTable.rows.add(formattedData).draw();
            } else {
                dataTable.clear().draw();
            }
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            try {
                const date = new Date(dateString);
                if (isNaN(date.getTime())) return '';
                return date.toLocaleDateString('en-GB'); // DD/MM/YYYY
            } catch (e) {
                return '';
            }
        }

        // Delegate Edit/Delete button clicks (works for both DataTable-drawn and manual rows)
        $(document).on('click', '.edit-btn', function() {
            editRecord($(this).data('id'));
        });
        $(document).on('click', '.delete-btn', function() {
            deleteRecord($(this).data('id'));
        });

        function escapeHtml(unsafe) {
            if (!unsafe) return '';
            return unsafe
                .toString()
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function clearForm() {
            currentEditId = null;
            $('#recordId').val('');
            $('#companyName').val('');
            $('#clientId').val('');
            $('#taskForm')[0].reset();
            if ($.fn.select2) {
                $('#clientSelect').val('').trigger('change.select2');
            } else {
                $('#clientSelect').val('');
            }
            $('#modalTitle').text('Add New AEX Audit Backlog Record');
        }

        function editRecord(id) {
            $.ajax({
                url: '/api/auditdept/aex42/get/' + id,
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        const record = response.data;
                        currentEditId = record.id;
                        $('#recordId').val(record.id);

                        const compName = record.companyName || record.CompanyName || '';
                        $('#companyName').val(compName);
                        if (compName && clientNameMap[compName.trim()]) {
                            const foundId = clientNameMap[compName.trim()];
                            $('#clientSelect').val(foundId);
                            if ($.fn.select2) $('#clientSelect').trigger('change.select2');
                        } else {
                            $('#clientSelect').val('');
                            if ($.fn.select2) $('#clientSelect').trigger('change.select2');
                        }

                        const client = (compName && clientNameMap[compName.trim()]) ? clientDataMap[clientNameMap[compName.trim()]] || {} : {};

                        // 从 client 解析 coSec / signingFirm / auditExemption
                        let clientCoSec = client.coSec || '';
                        let clientSigningFirm = client.signingFirm || '';
                        let clientAuditExemption = client.auditExemption || '';

                        if (client.appointmentEngagementData) {
                            try {
                                const apptData = typeof client.appointmentEngagementData === 'string'
                                    ? JSON.parse(client.appointmentEngagementData)
                                    : client.appointmentEngagementData;

                                const hasCoSec = (apptData.linkE22 && apptData.linkE22.coSecretary === true);
                                const hasSecDate = (apptData.appointments && apptData.appointments.Sec && apptData.appointments.Sec.appointmentDate);
                                if (hasCoSec || hasSecDate) clientCoSec = 'Yes';
                                else if (!clientCoSec) clientCoSec = 'No';

                                if (apptData.appointments && apptData.appointments.Audit && apptData.appointments.Audit.signingFirm) {
                                    clientSigningFirm = apptData.appointments.Audit.signingFirm;
                                } else if (apptData.linkE1 && apptData.linkE1.who) {
                                    clientSigningFirm = apptData.linkE1.who;
                                }
                            } catch (e) {}
                        }

                        // Populate form fields
                        $('#grouping').val(record.grouping || record.Grouping || client.grouping || '');
                        $('#quarterToDoAudit').val(record.quarterToDoAudit || record.QuarterToDoAudit || '');
                        $('#activity').val(record.activity || record.Activity || client.activitySize || client.activity || '');
                        $('#companyStatus').val(record.companyStatus || record.CompanyStatus || client.companyStatus || '');
                        $('#auditExemption').val(record.auditExemption || record.AuditExemption || clientAuditExemption || '');
                        $('#coSec').val(record.coSec || record.CoSec || clientCoSec || '');
                        $('#creditRating').val(record.creditRating || record.CreditRating || client.creditRating || '');
                        $('#signingFirm').val(record.signingFirm || record.SigningFirm || clientSigningFirm || '');
                        $('#yearEnd').val(record.yearEnd || record.YearEnd || '');

                        const yVal = record.yearToDo || record.YearToDo;
                        let formattedYearToDo = yVal || '';
                        if (formattedYearToDo && formattedYearToDo.includes('-')) {
                            formattedYearToDo = formattedYearToDo.split('-')[0];
                        } else if (formattedYearToDo && formattedYearToDo.includes('/')) {
                            const p = formattedYearToDo.split('/');
                            formattedYearToDo = p[p.length - 1];
                        }
                        $('#yearToDo').val(formattedYearToDo);
                        $('#moveToActiveSch').val(record.moveToActiveSch || record.MoveToActiveSch || '');

                        const dVal = record.dateDocIn || record.DateDocIn;
                        if (dVal) {
                            $('#dateDocIn').val(formatIsoForDateInput(dVal));
                        } else {
                            $('#dateDocIn').val('');
                        }

                        $('#acctngWk').val(record.acctngWk || record.AcctngWk || '');
                        $('#reasonWhyBacklog').val(record.reasonWhyBacklog || record.ReasonWhyBacklog || '');

                        $('#modalTitle').text('Edit AEX Audit Backlog Record');
                        $('#taskModal').modal('show');
                    } else {
                        alert('Error loading record: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    alert('Error loading record: ' + error);
                }
            });
        }

        function saveRecord() {
            const compName = $('#companyName').val() || ($('#clientSelect option:selected').val() ? $('#clientSelect option:selected').text() : '');

            if (!compName || compName.startsWith('--')) {
                alert('Company Name (Client) is required');
                return;
            }

            const formData = {
                Id: $('#recordId').val() || 0,
                Grouping: $('#grouping').val(),
                CompanyName: compName,
                QuarterToDoAudit: $('#quarterToDoAudit').val(),
                Activity: $('#activity').val(),
                CompanyStatus: $('#companyStatus').val(),
                AuditExemption: $('#auditExemption').val(),
                CoSec: $('#coSec').val(),
                CreditRating: $('#creditRating').val(),
                SigningFirm: $('#signingFirm').val(),
                YearEnd: $('#yearEnd').val(),
                YearToDo: $('#yearToDo').val(),
                MoveToActiveSch: $('#moveToActiveSch').val(),
                DateDocIn: $('#dateDocIn').val() ? $('#dateDocIn').val() : null,
                AcctngWk: $('#acctngWk').val(),
                ReasonWhyBacklog: $('#reasonWhyBacklog').val()
            };

            const url = currentEditId ? '/api/auditdept/aex42/update' : '/api/auditdept/aex42/create';
            const method = currentEditId ? 'PUT' : 'POST';

            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    if (response.success) {
                        $('#taskModal').modal('hide');
                        loadData();
                        alert(response.message);
                    } else {
                        alert('Error saving record: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    alert('Error saving record: ' + error);
                }
            });
        }

        function deleteRecord(id) {
            if (confirm('Are you sure you want to delete this record?')) {
                $.ajax({
                    url: '/api/auditdept/aex42/delete/' + id,
                    type: 'DELETE',
                    success: function(response) {
                        if (response.success) {
                            loadData();
                            alert(response.message);
                        } else {
                            alert('Error deleting record: ' + response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        alert('Error deleting record: ' + error);
                    }
                });
            }
        }
    </script>
}
