        function clearForm() {
            $('#taskForm')[0].reset();
            $('#recordId').val('');
            currentEditId = null;
            $('#modalTitle').text('Add New Audit AEX Template Record');
            $('#companyName').val('').trigger('change');
            $('#pic').val('').trigger('change');
            $('#noOfDays, #kuchingReviewDays, #totalFieldWkDays, #timelinessMetric').val('');
        }

        function editRecord(id) {
            console.log('Editing record:', id);

            $.ajax({
                url: `/api/auditdept/aex12/get/${id}`,
                type: 'GET',
                success: function(response) {
                    console.log('Edit response:', response);
                    if (response.success) {
                        const record = response.data;
                        currentEditId = record.id || record.Id;
                        $('#recordId').val(currentEditId);

                        const existingCompany = record.companyName || record.CompanyName || '';
                        const $select = $('#companyName');
                        if ($select.find(`option[value="${existingCompany}"]`).length === 0 && existingCompany) {
                            $select.append(`<option value="${existingCompany}">${existingCompany} (Archived)</option>`);
                        }
                        $select.val(existingCompany).trigger('change');
                        $('#activity').val(record.activity || record.Activity || '');
                        $('#whichDB').val(record.whichDB || record.WhichDB || '');
                        $('#yEnd').val(record.yEnd || record.YEnd || '');
                        $('#yEtodo').val(record.yEtodo || record.YEtodo || '');
                        handleYearEndChange();
                        $('#quarterTodo').val(record.quarterTodo || record.QuarterTodo || '');
                        
                        const existingPic = record.pic || record.PIC || '';
                        $('#pic').val(existingPic).trigger('change');

                        $('#status').val(record.status || record.Status || '');
                        $('#auditExrmption').val(record.auditExrmption || record.AuditExrmption || '');
                        $('#reportType').val(record.reportType || record.ReportType || '');
                        $('#signingFirm').val(record.signingFirm || record.SigningFirm || '');
                        $('#revenue').val(record.revenue || record.Revenue || '');
                        $('#profitLoss').val(record.profitLoss || record.ProfitLoss || '');
                        $('#auditFee').val(record.auditFee || record.AuditFee || '');
                        $('#dateBilled').val(record.dateBilled || record.DateBilled || '');
                        $('#startDate').val(record.startDate || record.StartDate || '');
                        $('#asAt').val(record.asAt || record.AsAt || '');
                        calculateDays();

                        $('#dateSentKuching').val(record.dateSentKuching || record.DateSentKuching || '');
                        $('#endDateKuching').val(record.endDateKuching || record.EndDateKuching || '');
                        calculateReviewDays();

                        $('#dateReport').val(record.dateReport || record.DateReport || '');
                        $('#dateOfDirectorRept').val(record.dateOfDirectorRept || record.DateOfDirectorRept || '');
                        $('#dateSentSigning').val(record.dateSentSigning || record.DateSentSigning || '');
                        $('#flwUpDate').val(record.flwUpDate || record.FlwUpDate || '');
                        $('#dateReceived').val(record.dateReceived || record.DateReceived || '');
                        $('#commOfOathsDate').val(record.commOfOathsDate || record.CommOfOathsDate || '');
                        $('#taxDueDate').val(record.taxDueDate || record.TaxDueDate || '');
                        if (record.ssmDueDate || record.SSMDueDate) {
                            $('#ssmDueDate').val(record.ssmDueDate || record.SSMDueDate);
                        }
                        $('#datePassToSecDept').val(record.datePassToSecDept || record.DatePassToSecDept || '');
                        if (record.targetTaxWorkDate || record.TargetTaxWorkDate) {
                            $('#targetTaxWorkDate').val(record.targetTaxWorkDate || record.TargetTaxWorkDate);
                        }
                        $('#passToTax').val(record.passToTax || record.PassToTax || '');
                        calculateMetric();

                        $('#isBinded').val(record.isBinded || record.IsBinded || '');
                        $('#dateBinded').val(record.dateBinded || record.DateBinded || '');

                        $('#modalTitle').text('Edit Audit AEX Template Record - ' + (record.companyName || record.CompanyName));
                        $('#taskModal').modal('show');
                    } else {
                        toastr.error('Error loading record: ' + (response.message || 'Unknown error'));
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Edit AJAX error:', xhr, status, error);
                    let errorMessage = 'Error loading record: ' + error;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = 'Server Error: ' + xhr.responseJSON.message;
                    }
                    toastr.error(errorMessage);
                }
            });
        }

        function saveRecord() {
            const companyNameVal = $('#companyName').val() ? $('#companyName').val().trim() : '';
            if (!companyNameVal) {
                toastr.warning('Company Name is required');
                $('#companyName').focus();
                return;
            }

            const formData = {
                id: currentEditId || 0,
                companyName: companyNameVal,
                activity: ($('#activity').val() || '').trim(),
                whichDB: $('#whichDB').val() || '',
                yEnd: ($('#yEnd').val() || '').trim(),
                yEtodo: ($('#yEtodo').val() || '').trim(),
                quarterTodo: $('#quarterTodo').val() || '',
                pic: ($('#pic').val() || '').trim(),
                status: ($('#status').val() || '').trim(),
                auditExrmption: ($('#auditExrmption').val() || '').trim(),
                reportType: ($('#reportType').val() || '').trim(),
                signingFirm: $('#signingFirm').val() || '',
                revenue: ($('#revenue').val() || '').toString(),
                profitLoss: ($('#profitLoss').val() || '').toString(),
                auditFee: ($('#auditFee').val() || '').toString(),
                dateBilled: ($('#dateBilled').val() || '').trim(),
                startDate: ($('#startDate').val() || '').trim(),
                asAt: ($('#asAt').val() || '').trim(),
                noOfDays: ($('#noOfDays').val() || '').toString(),
                totalFieldWkDays: ($('#totalFieldWkDays').val() || '').toString(),
                dateSentKuching: ($('#dateSentKuching').val() || '').trim(),
                endDateKuching: ($('#endDateKuching').val() || '').trim(),
                kuchingReviewDays: ($('#kuchingReviewDays').val() || '').toString(),
                dateReport: ($('#dateReport').val() || '').trim(),
                dateOfDirectorRept: ($('#dateOfDirectorRept').val() || '').trim(),
                dateSentSigning: ($('#dateSentSigning').val() || '').trim(),
                flwUpDate: ($('#flwUpDate').val() || '').trim(),
                dateReceived: ($('#dateReceived').val() || '').trim(),
                commOfOathsDate: ($('#commOfOathsDate').val() || '').trim(),
                taxDueDate: ($('#taxDueDate').val() || '').trim(),
                ssmDueDate: ($('#ssmDueDate').val() || '').trim(),
                datePassToSecDept: ($('#datePassToSecDept').val() || '').trim(),
                targetTaxWorkDate: ($('#targetTaxWorkDate').val() || '').trim(),
                passToTax: ($('#passToTax').val() || '').trim(),
                isBinded: $('#isBinded').val() || '',
                dateBinded: ($('#dateBinded').val() || '').trim()
            };

            console.log('Saving data:', formData);

            const url = currentEditId ? '/api/auditdept/aex12/update' : '/api/auditdept/aex12/create';
            const method = currentEditId ? 'PUT' : 'POST';

            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    console.log('Save response:', response);
                    if (response.success) {
                        $('#taskModal').modal('hide');
                        dataTable.ajax.reload();
                        toastr.success(response.message || 'Record saved successfully');
                    } else {
                        let errorMessage = 'Error saving record: ';
                        if (response.errors && response.errors.length > 0) {
                            errorMessage += response.errors.join(', ');
                        } else {
                            errorMessage += response.message || 'Unknown error';
                        }
                        toastr.error(errorMessage);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Save AJAX error:', xhr, status, error);
                    let errorMessage = 'Error saving record: ' + error;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMessage = 'Server Error: ' + xhr.responseJSON.message;
                    }
                    toastr.error(errorMessage);
                }
            });
        }
        function deleteRecord(id) {
            if (confirm('Are you sure you want to delete this record?')) {
                console.log('Deleting record:', id);

                $.ajax({
                    url: `/api/auditdept/aex12/delete/${id}`,
                    type: 'DELETE',
                    success: function(response) {
                        console.log('Delete response:', response);
                        if (response.success) {
                            dataTable.ajax.reload();
                            toastr.success(response.message || 'Record deleted successfully');
                        } else {
                            toastr.error('Error: ' + (response.message || 'Unknown error'));
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Delete AJAX error:', xhr, status, error);
                        let errorMessage = 'Error deleting record: ' + error;
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            errorMessage = 'Server Error: ' + xhr.responseJSON.message;
                        }
                        toastr.error(errorMessage);
                    }
                });
            }
        }
