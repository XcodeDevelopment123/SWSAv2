@{
    ViewData["Title"] = "Audit Aex Template";
}

<style>
    .dt-button-collection {
        max-height: 350px;
        overflow-y: auto;
        overscroll-behavior: contain;
    }
</style>

<h1>E1.2 AEX AUDIT</h1>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Audit AEX Template Records</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" onclick="clearForm()" data-bs-toggle="modal" data-bs-target="#taskModal">
                        <i class="fas fa-plus me-2"></i>New Record
                    </button>
                </div>
            </div>
            <div class="card-body" style="overflow:auto">
                <table id="taskDatatable" class="table table-bordered table-striped" style="width:100%">
                    <thead>
                        <tr>
                            <th colspan="15"></th>
                            <th colspan="4"> Audit WIP (days)</th>
                            <th colspan="4"> Review</th>
                            <th colspan="2"> AT3.3 Audit Reports from KK</th>
                            <th colspan="4"> AT3.4 Directors' Signing pages</th>
                            <th colspan="6"> 6. Tax/Sec Dept</th>
                            <th colspan="2"> 7. Post Audit Work</th>
                            <th rowspan="3">Action</th>
                        </tr>
                        <tr>
                            <th rowspan="2">ID</th>
                            <th rowspan="2">Company Name</th>
                            <th rowspan="2">Activity</th>
                            <th rowspan="2">Which database?</th>
                            <th rowspan="2">Year End</th>
                            <th rowspan="2">YE to do</th>
                            <th rowspan="2">Quarter to do</th>
                            <th rowspan="2">PIC</th>
                            <th rowspan="2">Status</th>
                            <th rowspan="2">Audit Exemption</th>
                            <th rowspan="2">Report Type</th>
                            <th rowspan="2">Signing Firm</th>

                            <th colspan="2">Est current yr result '000'</th>
                            <th colspan="2">Billing</th>

                            <th rowspan="2">a.Start date</th>
                            <th rowspan="2">b.As at</th>
                            <th rowspan="2">c.No of days</th>
                            <th rowspan="2">Total field work days</th>

                            <th colspan="3">Kuching 1st Review</th>
                            <th rowspan="2">2.Total Review days</th>

                            <th rowspan="2">Date of Report</th>
                            <th rowspan="2">Date of directors rept</th>

                            <th rowspan="2">Date sent</th>
                            <th rowspan="2">Follow up dates</th>
                            <th rowspan="2">Date received</th>
                            <th rowspan="2">Comm of Oaths date</th>

                            <th rowspan="2">Tax due date</th>
                            <th rowspan="2">SSM Due date</th>
                            <th rowspan="2">Date pass to sec dept (MBRS)</th>
                            <th rowspan="2">6a. Target Tax Work Date</th>
                            <th rowspan="2">6b. Date pass to tax dept</th>
                            <th rowspan="2">6c. Metric (# of days)</th>

                            <th rowspan="2">Binded?</th>
                            <th rowspan="2">Date binded</th>
                        </tr>
                        <tr>
                            <th>Revenue</th>
                            <th>Profit/Loss</th>
                            <th>Audit Fee</th>
                            <th>Date billed</th>

                            <th>a.Date sent</th>
                            <th>b.End date</th>
                            <th>c.Review days</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Data will be populated by DataTable -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskModalLabel">
                    <i class="fas fa-edit me-2"></i>
                    <span id="modalTitle">Add New Audit AEX Template Record</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
                <form id="taskForm">
                    <input type="hidden" id="recordId" value="">

                    <!-- Basic Information -->
                    <div class="form-info-label col-12">
                        <label>1. Basic Information</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="companyName">Company Name (Link From Client List)</label>
                                <select id="companyName" name="companyName" class="form-control select2" style="width:100%" required>
                                    <option value="">-- Select Company --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="activity">Activity</label>
                                <input type="text" id="activity" name="activity" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="whichDB">Which Database?</label>
                                <select id="whichDB" name="whichDB" class="form-control">
                                    <option value="">-- Select Database --</option>
                                    <option value="Active">Active</option>
                                    <option value="AEX">AEX</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="yEnd">Year End</label>
                                <input type="text" id="yEnd" name="yEnd" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="yEtodo">YE to do</label>
                                <input type="date" id="yEtodo" name="yEtodo" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="quarterTodo">Quarter to do</label>
                                <select id="quarterTodo" name="quarterTodo" class="form-control">
                                    <option value="">Select Quarter</option>
                                    <option value="1st Qtr">1st Qtr</option>
                                    <option value="2nd Qtr">2nd Qtr</option>
                                    <option value="3rd Qtr">3rd Qtr</option>
                                    <option value="4th Qtr">4th Qtr</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="pic">PIC</label>
                                <select id="pic" name="pic" class="form-control select2" style="width:100%">
                                    <option value="">-- Select PIC --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="status">Status</label>
                                <input type="text" id="status" name="status" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="auditExrmption">Audit Exemption</label>
                                <input type="text" id="auditExrmption" name="auditExrmption" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="reportType">Report Type</label>
                                <input type="text" id="reportType" name="reportType" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="signingFirm">Signing Firm</label>
                                <select id="signingFirm" class="form-control">
                                    <option value="">Select Signing Firm</option>
                                    <option value="BTM">BTM</option>
                                    <option value="KT NG">KT NG</option>
                                    <option value="RAKC">RAKC</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Financial Information -->
                    <div class="form-info-label col-12">
                        <label>2. Financial Information</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="revenue">Revenue ('000)</label>
                                <input type="number" id="revenue" name="revenue" class="form-control" placeholder="Enter revenue" step="0.01" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="profitLoss">Profit/(Loss) ('000)</label>
                                <input type="number" id="profitLoss" name="profitLoss" class="form-control" placeholder="Enter profit/loss" step="0.01" />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="auditFee">Audit Fee</label>
                                <input type="number" id="auditFee" name="auditFee" class="form-control" placeholder="Enter audit fee" step="0.01" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="dateBilled">Date Billed</label>
                                <input type="date" id="dateBilled" name="dateBilled" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <!-- Audit WIP (days) -->
                    <div class="form-info-label col-12">
                        <label>3. Audit WIP (days)</label>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="startDate">a. Start Date</label>
                                <input type="date" id="startDate" name="startDate" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="asAt">b. As at</label>
                                <input type="date" id="asAt" name="asAt" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="noOfDays">c. No of Days</label>
                                <input type="text" id="noOfDays" name="noOfDays" class="form-control" placeholder="Auto calculated" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="totalFieldWkDays">Total Field Work Days (c + Rc)</label>
                                <input type="number" id="totalFieldWkDays" name="totalFieldWkDays" class="form-control" placeholder="Auto calculate" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- Review - Kuching 1st Review -->
                    <div class="form-info-label col-12">
                        <label>Review - Kuching 1st Review</label>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="dateSentKuching">Ra. Date Sent</label>
                                <input type="date" id="dateSentKuching" name="dateSentKuching" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="endDateKuching">Rb. End Date</label>
                                <input type="date" id="endDateKuching" name="endDateKuching" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="kuchingReviewDays">Rc. Kuching Review Days</label>
                                <input type="text" id="kuchingReviewDays" name="kuchingReviewDays" class="form-control" placeholder="Auto calculated" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- AT3.3 Audit Reports from KK -->
                    <div class="form-info-label col-12">
                        <label>AT3.3 Audit Reports from KK</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="dateReport">Date of Report</label>
                                <input type="date" id="dateReport" name="dateReport" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="dateOfDirectorRept">Date of Directors Rept</label>
                                <input type="date" id="dateOfDirectorRept" name="dateOfDirectorRept" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <!-- AT3.4 Directors' signing pages -->
                    <div class="form-info-label col-12">
                        <label>AT3.4 Directors' signing pages</label>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="dateSentSigning">Date Sent</label>
                                <input type="date" id="dateSentSigning" name="dateSentSigning" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="flwUpDate">Follow up dates</label>
                                <input type="date" id="flwUpDate" name="flwUpDate" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="dateReceived">Date received</label>
                                <input type="date" id="dateReceived" name="dateReceived" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="commOfOathsDate">Comm of Oaths date</label>
                                <input type="date" id="commOfOathsDate" name="commOfOathsDate" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <!-- 6. Tax/Sec Dept -->
                    <div class="form-info-label col-12">
                        <label>6. Tax/Sec Dept</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="ssmDueDate">SSM Due Date (Auto YE+7m)</label>
                                <input type="date" id="ssmDueDate" name="ssmDueDate" class="form-control" placeholder="Auto calculate" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="datePassToSecDept">Date Pass to Sec Dept</label>
                                <input type="date" id="datePassToSecDept" name="datePassToSecDept" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="targetTaxWorkDate">6a. Target Tax Work Date (Auto YE+7m)</label>
                                <input type="date" id="targetTaxWorkDate" name="targetTaxWorkDate" class="form-control" placeholder="Auto calculate" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="passToTax">6b. Date pass to tax dept</label>
                                <input type="date" id="passToTax" name="passToTax" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="timelinessMetric">6c. Metric (# of days)</label>
                                <input type="text" id="timelinessMetric" name="timelinessMetric" class="form-control" placeholder="Auto calculated" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- 7. Post Audit Work -->
                    <div class="form-info-label col-12">
                        <label>7. Post Audit Work</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="isBinded">Binded?</label>
                                <select id="isBinded" class="form-control">
                                    <option value="">Select Y/N</option>
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="dateBinded">Date Binded</label>
                                <input type="date" id="dateBinded" name="dateBinded" class="form-control" />
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveBtn">
                    <i class="fas fa-save me-2"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_DatatablesScriptsPartial" />
    <link rel="stylesheet" href="~/admin-lte/plugins/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/admin-lte/plugins/select2-bootstrap4-theme/select2-bootstrap4.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="~/admin-lte/plugins/select2/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        let dataTable;
        let currentEditId = null;
        let clientDataMap = {};

        function addMonths(dateStr, months) {
            if (!dateStr) return "";
            const d = new Date(dateStr);
            if (isNaN(d.getTime())) return "";
            d.setMonth(d.getMonth() + months);
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function calculateDays() {
            const startStr = $('#startDate').val();
            const asAtStr = $('#asAt').val();
            let cDays = 0;
            if (startStr && asAtStr) {
                const startDate = new Date(startStr);
                const asAtDate = new Date(asAtStr);
                if (!isNaN(startDate) && !isNaN(asAtDate)) {
                    const diffTime = asAtDate - startDate;
                    cDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    $('#noOfDays').val(cDays >= 0 ? cDays : 0);
                }
            } else {
                $('#noOfDays').val('');
            }
            calculateTotalFieldWorkDays(cDays);
        }

        function calculateReviewDays() {
            const sendStr = $('#dateSentKuching').val();
            const endStr = $('#endDateKuching').val();
            let rcDays = 0;
            if (sendStr && endStr) {
                const sendDate = new Date(sendStr);
                const endDate = new Date(endStr);
                if (!isNaN(sendDate) && !isNaN(endDate)) {
                    const diffTime = endDate - sendDate;
                    rcDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    $('#kuchingReviewDays').val(rcDays >= 0 ? rcDays : 0);
                }
            } else {
                $('#kuchingReviewDays').val('');
            }
            const cDays = parseInt($('#noOfDays').val()) || 0;
            calculateTotalFieldWorkDays(cDays);
        }

        function calculateTotalFieldWorkDays(cDays) {
            const rcDays = parseInt($('#kuchingReviewDays').val()) || 0;
            $('#totalFieldWkDays').val(cDays + rcDays);
        }

        function calculateMetric() {
            const passTaxStr = $('#passToTax').val();
            const targetTaxStr = $('#targetTaxWorkDate').val();
            if (passTaxStr && targetTaxStr) {
                const passTaxDate = new Date(passTaxStr);
                const targetTaxDate = new Date(targetTaxStr);
                if (!isNaN(passTaxDate) && !isNaN(targetTaxDate)) {
                    const diffTime = passTaxDate - targetTaxDate;
                    const metricDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    $('#timelinessMetric').val(`${metricDays} days`);
                }
            } else {
                $('#timelinessMetric').val('');
            }
        }

        function handleYearEndChange() {
            const yeStr = $('#yEtodo').val();
            if (yeStr) {
                const autoDate = addMonths(yeStr, 7);
                $('#ssmDueDate').val(autoDate);
                $('#targetTaxWorkDate').val(autoDate);
                calculateMetric();
            }
        }

        function initSelect2() {
            $('#companyName').select2({
                theme: 'bootstrap4',
                placeholder: '-- Select Company --',
                allowClear: true,
                dropdownParent: $('#taskModal')
            });

            $('#pic').select2({
                theme: 'bootstrap4',
                placeholder: '-- Select PIC --',
                allowClear: true,
                dropdownParent: $('#taskModal')
            });

            $('#companyName').on('select2:open', function () {
                setTimeout(function () {
                    $('.select2-container--open .select2-search--dropdown .select2-search__field')
                        .attr('placeholder', 'Search by company name...');
                }, 10);
            });
        }

        function loadPicOptions() {
            $.ajax({
                url: '/users/pic',
                type: 'GET',
                success: function (res) {
                    if (res && Array.isArray(res)) {
                        const $select = $('#pic');
                        $select.find('option:not(:first)').remove();
                        res.forEach(item => {
                            const name = item.Name || item.name || '';
                            const dept = item.Department || item.department || '';
                            if (name) {
                                const label = dept ? `${name} (${dept})` : name;
                                $select.append(`<option value="${name}">${label}</option>`);
                            }
                        });
                        if ($('#pic').hasClass('select2-hidden-accessible')) {
                            $('#pic').trigger('change');
                        }
                    }
                },
                error: function (err) {
                    console.error('Failed to load PIC list', err);
                }
            });
        }

        function loadClientOptions() {
            $.ajax({
                url: '/api/auditdept/clients/get-list',
                type: 'GET',
                success: function (res) {
                    if (res && res.success && res.data) {
                        const $select = $('#companyName');
                        $select.find('option:not(:first)').remove();
                        clientDataMap = {};
                        res.data.forEach(client => {
                            const name = client.CompanyName || client.companyName || client.Name || client.name;
                            const type = client.ClientType || client.clientType || '';
                            if (name) {
                                let displayText = type ? `${name} (${type})` : name;
                                $select.append(`<option value="${name}">${displayText}</option>`);

                                clientDataMap[name] = {
                                    activity: client.ActivitySize || client.activitySize || '',
                                    yearEnd: client.YearEndMonth || client.yearEndMonth || '',
                                    status: 'Pending',
                                    auditExemption: client.AuditExemption !== undefined && client.AuditExemption !== null ? (client.AuditExemption ? 'Yes' : 'No') : '',
                                    reportType: (type === 'SdnBhd' || type === 'Sdn Bhd') ? 'AFS' : (client.ReportType || client.reportType || '')
                                };
                            }
                        });
                        if ($('#companyName').hasClass('select2-hidden-accessible')) {
                            $('#companyName').trigger('change');
                        }
                    }
                },
                error: function (err) {
                    console.error('Failed to load client list', err);
                }
            });
        }

        $(document).ready(function() {
            initSelect2();
            loadClientOptions();
            loadPicOptions();
            initializeDataTable();

            $(document).on('change', '#companyName', function () {
                const selectedName = $(this).val();
                if (selectedName && clientDataMap[selectedName]) {
                    const data = clientDataMap[selectedName];
                    if (data.activity) $('#activity').val(data.activity);
                    if (data.yearEnd) $('#yEnd').val(data.yearEnd);
                    $('#status').val('Pending');
                    if (data.auditExemption) $('#auditExrmption').val(data.auditExemption);
                    if (data.reportType) $('#reportType').val(data.reportType);
                } else if (!selectedName) {
                    $('#activity').val('');
                    $('#yEnd').val('');
                    $('#status').val('');
                    $('#auditExrmption').val('');
                    $('#reportType').val('');
                }
            });

            $(document).on('change input', '#startDate, #asAt', calculateDays);
            $(document).on('change input', '#dateSentKuching, #endDateKuching', calculateReviewDays);
            $(document).on('change input', '#passToTax, #targetTaxWorkDate', calculateMetric);
            $(document).on('change input', '#yEtodo', handleYearEndChange);

            $('#saveBtn').click(function() {
                saveRecord();
            });
        });

        function initializeDataTable() {
            dataTable = $('#taskDatatable').DataTable({
                processing: true,
                serverSide: false,
