@{
    ViewData["Title"] = "Form B & P Backlog";
}

<h1>F2.3 Form B & P Backlog</h1>

<div class="row">
    <div class="col-md-12">
        <div id="alertContainer"></div>
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-tasks me-2"></i> Form B & P Backlog Records
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#taskModal" id="addNewBtn">
                        <i class="fas fa-plus me-2"></i>New Task
                    </button>
                </div>
            </div>
            <div class="card-body">
                <table id="taskDatatable" class="table table-bordered table-striped w-100">
                    <thead>
                        <tr>
                            <th colspan="3" class="text-center">Admin</th>
                            <th colspan="15" class="text-center">Co Information</th>
                            <th rowspan="3" style="vertical-align: middle;">Actions</th>
                        </tr>
                        <tr>
                            <th rowspan="2" style="vertical-align: middle;">Grouping</th>
                            <th rowspan="2" style="vertical-align: middle;">Referral</th>
                            <th rowspan="2" style="vertical-align: middle;">File No</th>
                            <th rowspan="2" style="vertical-align: middle;">Co Name</th>
                            <th colspan="2" class="text-center">Registration</th>
                            <th colspan="2" class="text-center">Tax Reference</th>
                            <th colspan="2" class="text-center">MISC Code</th>
                            <th colspan="4" class="text-center">Work allocation Info</th>
                            <th colspan="1"></th>
                            <th colspan="3" class="text-center">Acc Dept</th>
                        </tr>
                        <tr>
                            <th>Registration Date</th>
                            <th>Company #</th>
                            <th>E number</th>
                            <th>TIN number</th>
                            <th>Code</th>
                            <th>Description</th>
                            <th>Services Type</th>
                            <th>Co Status</th>
                            <th>Activity/size</th>
                            <th>Year to do</th>
                            <th>Date Doc In</th>
                            <th>Month to do</th>
                            <th>Staff</th>
                            <th>Allocate to Wk Sch</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskModalLabel">
                    <i class="fas fa-edit me-2"></i>
                    <span id="modalTitle">Add New Form B & P Backlog</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="taskForm">
                    <input type="hidden" id="editIndex" value="">
                    <input type="hidden" id="recordId" value="">

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="grouping">Grouping</label>
                                <input type="text" id="grouping" name="grouping" class="form-control" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="referral">Referral</label>
                                <input type="text" id="referral" name="referral" class="form-control" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="fileNo">File No</label>
                                <input type="text" id="fileNo" name="fileNo" class="form-control" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="coName">Co Name (Select Enterprise)</label>
                                <select id="enterpriseCompanySelect" class="form-control">
                                    <option value="">-- Loading Enterprise Clients... --</option>
                                </select>
                                <small class="text-muted">
                                    Options are linked from the Enterprise Client List.
                                </small>
                                <input type="hidden" id="coName" name="coName" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="yearEnd">Year End</label>
                                <input type="text" id="yearEnd" name="yearEnd" class="form-control" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="incorpDate">Registration Date</label>
                                <input type="text" id="incorpDate" name="incorpDate" class="form-control datepicker" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="coNumber">Company #</label>
                                <input type="text" id="coNumber" name="coNumber" class="form-control" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="eNumber">E number</label>
                                <input type="text" id="eNumber" name="eNumber" class="form-control" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="tinNumber">TIN number</label>
                                <input type="text" id="tinNumber" name="tinNumber" class="form-control" placeholder="Auto-fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="miscCode">MISC Code</label>
                                <input type="text" id="miscCode" name="miscCode" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="miscDescription">MISC Description</label>
                                <input type="text" id="miscDescription" name="miscDescription" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="servicesType">Services Type</label>
                                <input type="text" id="servicesType" name="servicesType" class="form-control" placeholder="Enter services type" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="coStatus">Co Status</label>
                                <input type="text" id="coStatus" name="coStatus" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="activitySize">Active Co:Activity/size</label>
                                <input type="text" id="activitySize" name="activitySize" class="form-control" placeholder="Auto fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="yeToDo">Year to do</label>
                                <select id="yeToDo" name="yeToDo" class="form-control">
                                    <option value="">Select Year</option>
                                    <option value="2026">2026</option>
                                    <option value="2027">2027</option>
                                    <option value="2028">2028</option>
                                    <option value="2029">2029</option>
                                    <option value="2030">2030</option>
                                    <option value="2031">2031</option>
                                    <option value="2032">2032</option>
                                    <option value="2033">2033</option>
                                    <option value="2034">2034</option>
                                    <option value="2035">2035</option>
                                    <option value="2036">2036</option>
                                    <option value="2037">2037</option>
                                    <option value="2038">2038</option>
                                    <option value="2039">2039</option>
                                    <option value="2040">2040</option>
                                    <option value="2041">2041</option>
                                    <option value="2042">2042</option>
                                    <option value="2043">2043</option>
                                    <option value="2044">2044</option>
                                    <option value="2045">2045</option>
                                    <option value="2046">2046</option>
                                    <option value="2047">2047</option>
                                    <option value="2048">2048</option>
                                    <option value="2049">2049</option>
                                    <option value="2050">2050</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="dateDocIn">Date Doc In</label>
                                <input type="text" id="dateDocIn" name="dateDocIn" class="form-control datepicker" placeholder="Select date" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="estMonthToDo">EST Month to do</label>
                                <select id="estMonthToDo" name="estMonthToDo" class="form-control">
                                    <option value="">Select Month</option>
                                    <option value="Jan">January</option>
                                    <option value="Feb">February</option>
                                    <option value="Mar">March</option>
                                    <option value="Apr">April</option>
                                    <option value="May">May</option>
                                    <option value="Jun">June</option>
                                    <option value="Jul">July</option>
                                    <option value="Aug">August</option>
                                    <option value="Sep">September</option>
                                    <option value="Oct">October</option>
                                    <option value="Nov">November</option>
                                    <option value="Dec">December</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="staff">Staff</label>
                                <select id="staff" name="staff" class="form-control">
                                    <option value="">-- Select Staff --</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="allocateToWkSch">Allocate to Wk Sch</label>
                                <select id="allocateToWkSch" name="allocateToWkSch" class="form-control">
                                    <option value="">Select Option</option>
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveBtn">
                    <i class="fas fa-save me-2"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_DatatablesScriptsPartial" />

    <!-- Include Datepicker -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>

    <script>
        $(document).ready(function() {
            let dataTable;
            let currentEditId = null;
            let enterpriseOptionsMap = {};

            // 1. 加载 Enterprise Company Options
            function loadEnterpriseOptions() {
                $.ajax({
                    url: '/api/get/enterprise-company-options',
                    type: 'GET',
                    success: function (res) {
                        if (res.success && res.data) {
                            enterpriseOptionsMap = {};
                            const $sel = $('#enterpriseCompanySelect');
                            $sel.empty().append('<option value="">-- Select Enterprise Company --</option>');

                            res.data.forEach(client => {
                                enterpriseOptionsMap[client.id] = client;
                                const displayText = client.companyNo
                                    ? `${client.companyName} (${client.companyNo})`
                                    : client.companyName;

                                $sel.append(`<option value="${client.id}">${displayText}</option>`);
                            });
                        }
                    },
                    error: function(xhr) {
                        console.error("Failed to load enterprise options", xhr);
                    }
                });
            }

            // 2. Helper: Month -> Date String
            function yearEndMonthToDateString(monthName) {
                if (!monthName) return '';
                if (monthName.includes('/') || monthName.includes('-')) return monthName;

                const months = [
                    'January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'
                ];

                const idx = months.findIndex(m => m.toLowerCase() === monthName.toLowerCase());
                if (idx === -1) return monthName;

                const today = new Date();
                let year = today.getFullYear();
                if (idx < today.getMonth()) year += 1;

                const dt = new Date(year, idx + 1, 0);
                return formatDdMMyyyy(dt);
            }

            // 3. Helper: Format Date
            function formatDdMMyyyy(d) {
                const date = (d instanceof Date) ? d : new Date(d);
                if (isNaN(date)) return "";
                const dd = String(date.getDate()).padStart(2, '0');
                const mm = String(date.getMonth() + 1).padStart(2, '0');
                const yyyy = date.getFullYear();
                return `${dd}/${mm}/${yyyy}`;
            }

            // 4. Dropdown Change Event (Auto-fill)
            $('#enterpriseCompanySelect').change(function() {
                const selectedId = $(this).val();

                if (!selectedId || !enterpriseOptionsMap[selectedId]) {
                    $('#coName').val('');
                    $('#grouping').val('');
                    $('#referral').val('');
                    $('#fileNo').val('');
                    $('#yearEnd').val('');
                    $('#coNumber').val('');
                    $('#eNumber').val('');
                    $('#tinNumber').val('');
                    $('#incorpDate').val('');
                    $('#miscCode').val('');
                    $('#miscDescription').val('');
                    $('#coStatus').val('');
                    $('#activitySize').val('');
                    return;
                }

                const c = enterpriseOptionsMap[selectedId];

                $('#coName').val(c.companyName || '');
                $('#grouping').val(c.grouping || '');
                $('#referral').val(c.referral || '');
                $('#fileNo').val(c.fileNo || '');
                $('#coNumber').val(c.companyNo || c.registrationNo || '');
                $('#eNumber').val(c.employerNumber || c.eNumber || '');
                $('#tinNumber').val(c.taxIdentificationNumber || c.tiNnumber || '');

                const rawYearEnd = c.yearEndMonth || c.yearEnd || '';
                $('#yearEnd').val(yearEndMonthToDateString(rawYearEnd));

                if (c.incorporationDate) {
                    $('#incorpDate').datepicker('update', new Date(c.incorporationDate));
                } else {
                    $('#incorpDate').val('');
                }

                $('#miscCode').val(c.miscCode || '');
                $('#miscDescription').val(c.miscDescription || '');
                $('#coStatus').val(c.companyStatus || '');
                $('#activitySize').val(c.activitySize || '');
            });

            function loadStaffOptions() {
                $.ajax({
                    url: '/users/pic',
                    type: 'GET',
                    success: function (res) {
                        const users = Array.isArray(res) ? res : (res?.data || []);
                        const $staffSelect = $('#staff');
                        $staffSelect.find('option:not(:first)').remove();
                        users.forEach(user => {
                            const val = user.name || user.Name || '';
                            if (val) {
                                const dept = (user.department || user.Department) ? ` (${user.department || user.Department})` : '';
                                $staffSelect.append(`<option value="${val}">${val}${dept}</option>`);
                            }
                        });
                    },
                    error: function (xhr) {
                        console.error('Failed to load staff options', xhr);
                    }
                });
            }

            function initializeDatePickers() {
                $('.datepicker').datepicker({
                    format: 'yyyy-mm-dd',
                    autoclose: true,
                    todayHighlight: true
                });
            }

            function formatDate(dateString) {
                if (!dateString) return '';
                try {
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-GB');
                } catch (e) {
                    return dateString;
                }
            }

            function showAlert(message, type) {
                const alertClass = `alert alert-${type} alert-dismissible fade show`;
                const alertHtml = `
                    <div class="${alertClass}" role="alert">
                        <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'danger' ? 'fa-exclamation-circle' : 'fa-info-circle'} me-2"></i>
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                if ($('#alertContainer').length === 0) {
                    $('.card-header').after('<div id="alertContainer"></div>');
                }
                $('#alertContainer').html(alertHtml);
                setTimeout(() => { $('.alert').alert('close'); }, 5000);
            }

            function resetForm() {
                $('#taskForm')[0].reset();
                currentEditId = null;
                $('#modalTitle').text('Add New ACC Form B & P Backlog');
                $('.datepicker').datepicker('update', '');
                $('#recordId').val('');
                $('#enterpriseCompanySelect').val('');
            }

            function getFormData() {
                return {
                    grouping: $('#grouping').val(),
                    refferal: $('#referral').val(),
                    fileNo: $('#fileNo').val(),
                    companyName: $('#coName').val(),
                    yearEnd: $('#yearEnd').val(),
                    registrationDate: $('#incorpDate').val(),
                    co: $('#coNumber').val(),
                    enumber: $('#eNumber').val(),
                    tiNnumber: $('#tinNumber').val(),
                    login: $('#login').val(),
                    password: $('#password').val(),
                    code: $('#miscCode').val(),
                    description: $('#miscDescription').val(),
                    jobService: $('#servicesType').val(),
                    activeCoActivitySize: $('#activitySize').val(),
                    yEtoDo: $('#yeToDo').val(),
                    dateDocIn: $('#dateDocIn').val(),
                    mthTodo: $('#estMonthToDo').val(),
                    staff: $('#staff').val(),
                    allocateToWkSch: $('#allocateToWkSch').val()
                };
            }

            function populateForm(data) {
                $('#grouping').val(data.grouping || '');
                $('#referral').val(data.refferal || '');
                $('#fileNo').val(data.fileNo || '');
                $('#coName').val(data.companyName || '');
                $('#yearEnd').val(data.yearEnd || '');
                $('#incorpDate').val(data.registrationDate ? data.registrationDate.split('T')[0] : '');
                $('#coNumber').val(data.co || '');
                $('#eNumber').val(data.enumber || '');
                $('#tinNumber').val(data.tiNnumber || '');
                $('#miscCode').val(data.code || '');
                $('#miscDescription').val(data.description || '');
                $('#servicesType').val(data.jobService || '');
                $('#activitySize').val(data.activeCoActivitySize || '');
                $('#yeToDo').val(data.yEtoDo || '');
                $('#dateDocIn').val(data.dateDocIn ? data.dateDocIn.split('T')[0] : '');
                $('#estMonthToDo').val(data.mthTodo || '');
                $('#staff').val(data.staff || '');
                $('#allocateToWkSch').val(data.allocateToWkSch || '');

                let foundId = "";
                for (const [key, val] of Object.entries(enterpriseOptionsMap)) {
                    if (val.companyName === data.companyName) {
                        foundId = key;
                        break;
                    }
                }
                $('#enterpriseCompanySelect').val(foundId);
            }

            function testApiConnection() {
                console.log('Testing API connection to /api/bp23/get-all');
                $.ajax({
                    url: '/api/bp23/get-all',
                    type: 'GET',
                    dataType: 'json',
                    success: function(response) {
                        if (response.success) {
                            initializeDataTable();
                        } else {
                            showAlert('API returned error: ' + response.message, 'danger');
                            initializeSimpleTable();
                        }
                    },
                    error: function(xhr, status, error) {
                        showAlert('Cannot connect to server.', 'danger');
                        initializeSimpleTable();
                    }
                });
            }

            function initializeDataTable() {
                try {
                    if ($.fn.DataTable.isDataTable('#taskDatatable')) {
                        dataTable.destroy();
                        $('#taskDatatable').empty();
                    }

                    dataTable = $('#taskDatatable').DataTable({
                        "processing": true,
                        "serverSide": false,
                        "paging": true,
                        "lengthChange": false,
                        "searching": true,
                        "ordering": true,
                        "info": true,
                        "autoWidth": false,
                        "responsive": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "ajax": {
                            "url": "/api/bp23/get-all",
                            "type": "GET",
                            "dataSrc": function(response) {
                                return response.success ? response.data : [];
                            },
                            "error": function(xhr, error, thrown) {
                                showAlert('Failed to load data: ' + error, 'danger');
                            }
                        },
                        "columns": [
                            { "data": "grouping", "defaultContent": "" },
                            { "data": "refferal", "defaultContent": "" },
                            { "data": "fileNo", "defaultContent": "" },
                            { "data": "companyName", "defaultContent": "" },
                            {
                                "data": "registrationDate",
                                "render": function(data) { return data ? formatDate(data) : ''; },
                                "defaultContent": ""
                            },
                            { "data": "co", "defaultContent": "" },
                            { "data": "enumber", "defaultContent": "" },
                            { "data": "tiNnumber", "defaultContent": "" },
                            { "data": "code", "defaultContent": "" },
                            { "data": "description", "defaultContent": "" },
                            { "data": "jobService", "defaultContent": "" },
                            {
                                "data": null,
                                "defaultContent": "",
                                "render": function() { return ""; }
                            }, // Co Status
                            { "data": "activeCoActivitySize", "defaultContent": "" },
                            { "data": "yEtoDo", "defaultContent": "" },
                            {
                                "data": "dateDocIn",
                                "render": function(data) { return data ? formatDate(data) : ''; },
                                "defaultContent": ""
                            },
                            { "data": "mthTodo", "defaultContent": "" },
                            { "data": "staff", "defaultContent": "" },
                            { "data": "allocateToWkSch", "defaultContent": "" },
                            {
                                "data": null,
                                "render": function(data, type, row) {
                                    const name = encodeURIComponent(row.companyName || '');
                                    return `
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-warning edit-btn" data-id="${row.id}" title="Edit"><i class="fas fa-edit"></i></button>
                                            <a href="/AccountDept/FormBnPMasterScheduleList?company=${name}" class="btn btn-sm btn-success" title="Move/Go to Schedule (F1.3)"><i class="fas fa-arrow-right me-1"></i>F1.3</a>
                                            <button class="btn btn-sm btn-danger delete-btn" data-id="${row.id}" title="Delete"><i class="fas fa-trash"></i></button>
                                        </div>
                                    `;
                                },
                                "orderable": false
                            }
                        ],
                        "order": [[0, 'desc']],
                    });
                    dataTable.buttons().container().appendTo('#taskDatatable_wrapper .col-md-6:eq(0)');
                } catch (error) {
                    console.error('DataTable initialization failed:', error);
                    initializeSimpleTable();
                }
            }

            function initializeSimpleTable() {
                $.ajax({
                    url: '/api/bp23/get-all',
                    type: 'GET',
                    success: function(response) {
                        if (response.success && response.data) {
                            var tbody = $('#taskDatatable tbody');
                            tbody.empty();
                            response.data.forEach(function(item) {
                                var row = `<tr>
                                    <td>${item.grouping}</td>
                                    <td>${item.refferal}</td>
                                    <td>${item.fileNo}</td>
                                    <td>${item.companyName}</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning edit-btn" data-id="${item.id}">Edit</button>
                                    </td>
                                </tr>`;
                                tbody.append(row);
                            });
                        }
                    }
                });
            }

            function saveBP23Record() {
                const formData = getFormData();
                const url = currentEditId ? '/api/bp23/update' : '/api/bp23/create';
                const method = currentEditId ? 'PUT' : 'POST';

                if (currentEditId) formData.id = currentEditId;

                $('#saveBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Saving...');

                $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        $('#saveBtn').prop('disabled', false).html('<i class="fas fa-save me-2"></i>Save');
                        if (response.success) {
                            $('#taskModal').modal('hide');
                            refreshTable();
                            resetForm();
                            showAlert('Record saved successfully!', 'success');
                        } else {
                            showAlert('Error saving record: ' + response.message, 'danger');
                        }
                    },
                    error: function(xhr, status, error) {
                        $('#saveBtn').prop('disabled', false).html('<i class="fas fa-save me-2"></i>Save');
                        showAlert('Error saving record: ' + error, 'danger');
                    }
                });
            }

            function editRecord(id) {
                $.get(`/api/bp23/get/${id}`, function(response) {
                    if (response.success) {
                        const record = response.data;
                        currentEditId = record.id;
                        populateForm(record);
                        $('#modalTitle').text('Edit ACC Form B & P Backlog');
                        $('#taskModal').modal('show');
                    } else {
                        showAlert('Error loading record: ' + response.message, 'danger');
                    }
                }).fail(function(xhr, status, error) {
                    showAlert('Error loading record: ' + error, 'danger');
                });
            }

            function deleteRecord(id) {
                if (confirm('Are you sure you want to delete this record?')) {
                    $.ajax({
                        url: `/api/bp23/delete/${id}`,
                        type: 'DELETE',
                        success: function(response) {
                            if (response.success) {
                                refreshTable();
                                showAlert('Record deleted successfully!', 'success');
                            } else {
                                showAlert('Error deleting record: ' + response.message, 'danger');
                            }
                        },
                        error: function(xhr, status, error) {
                            showAlert('Error deleting record: ' + error, 'danger');
                        }
                    });
                }
            }

            function refreshTable() {
                if (dataTable && typeof dataTable.ajax.reload === 'function') {
                    dataTable.ajax.reload(null, false);
                } else {
                    initializeSimpleTable();
                }
            }

            // 事件绑定
            $('#saveBtn').click(saveBP23Record);
            $(document).on('click', '.edit-btn', function() { editRecord($(this).data('id')); });
            $(document).on('click', '.delete-btn', function() { deleteRecord($(this).data('id')); });
            $('#taskModal').on('hidden.bs.modal', resetForm);

            $('#addNewBtn').click(function() {
                resetForm();
                $('#modalTitle').text('Add New ACC Form B & P Backlog');
            });

            $('#taskForm').on('submit', function(e) {
                e.preventDefault();
                saveBP23Record();
            });

            // 初始化
            console.log('Initializing ACC Form B & P Backlog application...');
            initializeDatePickers();
            loadEnterpriseOptions();
            loadStaffOptions();
            testApiConnection();
        });
    </script>
}