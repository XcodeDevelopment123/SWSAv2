                //     "autoWidth": false
                // });
            

            // === 5. 保存记录 ===
            $('#saveBtn').click(function() {
                const compVal = $('#companyName').val() || $('#companySelect option:selected').text();
                if (!$('#companySelect').val()) {
                    Popup_Warning('Validation', 'Please select an Individual Client.');
                    return;
                }

                const formData = {
                    id: currentEditId ? parseInt(currentEditId) : 0,
                    grouping: $('#grouping').val() || '',
                    refferal: $('#referral').val() || '',
                    fileNo: $('#fileNo').val() || '',
                    companyName: compVal || '',
                    yearEnd: $('#yearEnd').val() || '',
                    enumber: $('#enumber').val() || '',
                    tinNumber: $('#tinNumber').val() || '',
                    login: $('#login').val() || '',
                    password: $('#password').val() || '',
                    code: $('#code').val() || '',
                    description: $('#description').val() || '',
                    jobServices: $('#jobServices').val() || '',
                    yEtodo: $('#yEtodo').val() || '',
                    dateDocIn: $('#dateDocIn').val() || '',
                    mthTodo: $('#mthTodo').val() || '',
                    staff: $('#staff').val() || '',
                    allocateToWkSch: $('#allocateToWkSch').val() || '',
                    completed: $('#completed').val() || '',

                    // 同时携带 PascalCase 属性，确保 .NET 无论哪种序列化配置都能接收到
                    Grouping: $('#grouping').val() || '',
                    Refferal: $('#referral').val() || '',
                    FileNo: $('#fileNo').val() || '',
                    CompanyName: compVal || '',
                    YearEnd: $('#yearEnd').val() || '',
                    Enumber: $('#enumber').val() || '',
                    TinNumber: $('#tinNumber').val() || '',
                    Login: $('#login').val() || '',
                    Password: $('#password').val() || '',
                    Code: $('#code').val() || '',
                    Description: $('#description').val() || '',
                    JobServices: $('#jobServices').val() || '',
                    YEtodo: $('#yEtodo').val() || '',
                    DateDocIn: $('#dateDocIn').val() || '',
                    MthTodo: $('#mthTodo').val() || '',
                    Staff: $('#staff').val() || '',
                    AllocateToWkSch: $('#allocateToWkSch').val() || '',
                    Completed: $('#completed').val() || ''
                };

                console.log('Sending BP25 formData:', formData);

                const url = currentEditId ? '/api/bp25/update' : '/api/bp25/create';
                const method = currentEditId ? 'PUT' : 'POST';

                $('#saveBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(res) {
                        $('#saveBtn').prop('disabled', false).html('<i class="fas fa-save me-2"></i>Save');
                        if (res.success) {
                            $('#taskModal').modal('hide');
                            dataTable.ajax.reload(null, false);
                            resetForm();
                            Popup_Success('Saved!', 'Record saved successfully!');
                        } else {
                            Popup_Error('Save Failed', res.message || 'Error saving record');
                        }
                    },
                    error: function(xhr) {
                        $('#saveBtn').prop('disabled', false).html('<i class="fas fa-save me-2"></i>Save');
                        Popup_Error('Save Error', xhr.responseText || 'System error');
                    }
                });
            });

            // === 6. 编辑记录 (反向绑定) ===
            $(document).on('click', '.edit-btn', function() {
                const id = $(this).data('id');
                $.get(`/api/bp25/get/${id}`, function(res) {
                    if (res.success) {
                        const d = res.data;
                        currentEditId = d.id || d.Id;
                        $('#modalTitle').text('Edit Record');

                        const compName = d.companyName || d.CompanyName || '';
                        // 反向查找 Dropdown ID
                        let foundId = "";
                        for (const [key, val] of Object.entries(companyOptionsMap)) {
                            if (val.companyName === compName) {
                                foundId = key;
                                break;
                            }
                        }
                        $('#companySelect').val(foundId);

                        // 填充 Input (兼容大小写)
                        $('#grouping').val(d.grouping || d.Grouping || '');
                        $('#referral').val(d.refferal || d.Refferal || d.referral || d.Referral || '');
                        $('#fileNo').val(d.fileNo || d.FileNo || '');
                        $('#companyName').val(compName);
                        $('#yearEnd').val(d.yearEnd || d.YearEnd || '');
                        $('#enumber').val(d.enumber || d.Enumber || '');
                        $('#tinNumber').val(d.tinNumber || d.TinNumber || '');
                        $('#login').val(d.login || d.Login || '');
                        $('#password').val(d.password || d.Password || '');
                        $('#code').val(d.code || d.Code || '');
                        $('#description').val(d.description || d.Description || '');
                        $('#jobServices').val(d.jobServices || d.JobServices || '');
                        $('#yEtodo').val(d.yEtodo || d.YEtodo || '');
                        
                        const docInVal = d.dateDocIn || d.DateDocIn || '';
                        $('#dateDocIn').val(docInVal);
                        
                        $('#mthTodo').val(d.mthTodo || d.MthTodo || '');
                        $('#staff').val(d.staff || d.Staff || '');
                        $('#allocateToWkSch').val(d.allocateToWkSch || d.AllocateToWkSch || '');
                        $('#completed').val(d.completed || d.Completed || '');

                        $('#taskModal').modal('show');
                    } else {
                        Popup_Error('Error', res.message || 'Failed to load record');
                    }
                });
            });

            // === 7. 删除记录 ===
            $(document).on('click', '.delete-btn', function() {
                const id = $(this).data('id');
                Popup_Questions('Delete Record', 'Are you sure you want to delete this record? This action cannot be undone.').then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: `/api/bp25/delete/${id}`,
                            type: 'DELETE',
                            success: function(res) {
                                if (res.success) {
                                    dataTable.ajax.reload(null, false);
                                    Popup_Success('Deleted!', 'Record deleted successfully!');
                                } else {
                                    Popup_Error('Delete Failed', res.message || 'Failed to delete record');
                                }
                            },
                            error: function(err) {
                                Popup_Error('Delete Error', err.statusText || 'Failed to delete record');
                            }
                        });
                    }
                });
            });

            // === 8. 重置 ===
            $('#addNewBtn').click(function() {
                resetForm();
                $('#companySelect').val('');
                $('#modalTitle').text('Add New Record Individual Form BE List');
            });

            function resetForm() {
                $('#taskForm')[0].reset();
                currentEditId = null;
                $('.datepicker').datepicker('update', '');
                $('#recordId').val('');
            }

            // 初始化执行
            initializeDatePickers();
            function initializeDatePickers() {
                $('.datepicker').datepicker({
                    format: 'yyyy-mm-dd',
                    autoclose: true,
                    todayHighlight: true
                });
            }

            initializeDataTable();
        });
    </script>
}