    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>

    <script>
        $(document).ready(function() {
            let dataTable;
            let currentEditId = null;
            let companyOptionsMap = {}; // 缓存 Individual Client 数据

            // === 1. 日期工具函数 ===
            function formatDdMMyyyy(d) {
                const date = (d instanceof Date) ? d : new Date(d);
                if (isNaN(date)) return "";
                const dd = String(date.getDate()).padStart(2, '0');
                const mm = String(date.getMonth() + 1).padStart(2, '0');
                const yyyy = date.getFullYear();
                return `${dd}/${mm}/${yyyy}`;
            }

            function formatDate(dateString) {
                if (!dateString) return '';
                try {
                    const date = new Date(dateString);
                    return date.toLocaleDateString('en-GB'); // DD/MM/YYYY
                } catch (e) { return dateString; }
            }

            function yearEndMonthToDateString(monthName) {
                if (!monthName) return '';
                const months = [
                    'January', 'February', 'March', 'April', 'May', 'June',
                    'July', 'August', 'September', 'October', 'November', 'December'
                ];
                const idx = months.indexOf(monthName);
                if (idx === -1) return monthName;

                const today = new Date();
                let year = today.getFullYear();
                if (idx < today.getMonth()) year += 1; // 如果月已过，算明年

                const dt = new Date(year, idx + 1, 0);
                return formatDdMMyyyy(dt);
            }

            // === 2. 加载 Individual 客户下拉菜单 ===
            function loadCompanyOptions() {
                $.ajax({
                    url: '/api/get/individual-company-options', // 你的新 API
                    type: 'GET',
                    success: function (res) {
                        if (res.success && res.data) {
                            companyOptionsMap = {};
                            const $sel = $('#companySelect');
                            $sel.empty().append('<option value="">-- Select Individual --</option>');

                            res.data.forEach(client => {
                                // 缓存数据 (client: { id, grouping, referral, companyName, yearEndMonth, taxIdentificationNumber })
                                companyOptionsMap[client.id] = client;

                                // 显示名字 (Individual 通常没有 CompanyNo，直接显示 Name)
                                $sel.append(`<option value="${client.id}">${client.companyName}</option>`);
                            });
                        }
                    },
                    error: function(xhr) { console.error("Failed to load individuals", xhr); }
                });
            }
            loadCompanyOptions(); // 立即加载

            // === 3. 下拉菜单联动 (Auto-fill) ===
            $('#companySelect').on('change', function () {
                const selectedId = $(this).val();

                if (!selectedId || !companyOptionsMap[selectedId]) {
                    $('#grouping').val('');
                    $('#referral').val('');
                    $('#companyName').val('');
                    $('#yearEnd').val('');
                    $('#tinNumber').val('');
                    return;
                }

                const c = companyOptionsMap[selectedId];

                // 自动填充字段
                $('#grouping').val(c.grouping || '');
                $('#referral').val(c.referral || ''); // 注意检查 DTO 里是 Referral 还是 Refferal
                $('#companyName').val(c.companyName || ''); // 填入隐藏字段

                // Year End 转换
                const formattedYearEnd = yearEndMonthToDateString(c.yearEndMonth || '');
                $('#yearEnd').val(formattedYearEnd);

                // TIN Number (对应 Individual 的 Tax ID)
                $('#tinNumber').val(c.taxIdentificationNumber || '');
            });

            // === 4. 初始化 DataTable ===
            function initializeDataTable() {
                if ($.fn.DataTable.isDataTable('#taskDatatable')) {
                    $('#taskDatatable').DataTable().destroy();
                }


            dataTable = $('#taskDatatable').DataTable({
                paging: true,
                lengthChange: false,
                searching: true,
                ordering: true,
                info: true,
                autoWidth: false,
                scrollX: true,
                dom: '<"d-flex justify-content-between align-items-center mb-2"Bf>rtip',
                buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"],
                "ajax": {
                    "url": "/api/bp25/get-all",
                    "type": "GET",
                    "dataSrc": function(res) { return res.success ? res.data : []; }
                },
                "columns": [
                    { 
                        "data": "grouping", 
                        "render": function(data, type, row) { return data || row.Grouping || ''; },
                        "defaultContent": "" 
                    },
                    { 
                        "data": "refferal", 
                        "render": function(data, type, row) { return data || row.Refferal || row.referral || row.Referral || ''; },
                        "defaultContent": "" 
                    },
                    { 
                        "data": "companyName", 
                        "render": function(data, type, row) { return data || row.CompanyName || ''; },
                        "defaultContent": "" 
                    },
                    { 
                        "data": "tinNumber", 
                        "render": function(data, type, row) { return data || row.TinNumber || ''; },
                        "defaultContent": "" 
                    },
                    { 
                        "data": "login", 
                        "render": function(data, type, row) { return data || row.Login || ''; },
                        "defaultContent": "" 
                    },
                    { 
                        "data": "password", 
                        "render": function(data, type, row) { return data || row.Password || ''; },
                        "defaultContent": "" 
                    },
                    {
                        "data": "dateDocIn",
                        "render": function(data, type, row) { 
                            const val = data || row.DateDocIn;
                            return val || '-'; 
                        },
                        "defaultContent": ""
                    },
                    { 
                        "data": "allocateToWkSch", 
                        "render": function(data, type, row) { return data || row.AllocateToWkSch || ''; },
                        "defaultContent": "" 
                    },
                    { 
                        "data": "completed", 
                        "render": function(data, type, row) { return data || row.Completed || ''; },
                        "defaultContent": "" 
                    },
                    {
                        "data": "id",
                        "render": function(data, type, row) {
                            const val = data || row.Id;
                            return `
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-warning edit-btn" data-id="${val}" title="Edit"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-danger delete-btn" data-id="${val}" title="Delete"><i class="fas fa-trash"></i></button>
                                </div>`;
                        },
                        "orderable": false
                    }
                ],
                "order": [[0, 'desc']]
            });
        }
                // dataTable = $('#taskDatatable').DataTable({
                //     "ajax": {
                //         "url": "/api/bp25/get-all", // 确保这是 Form BE 的 API
                //         "type": "GET",
                //         "dataSrc": function(res) { return res.success ? res.data : []; }
                //     },
                //     "columns": [
                //         { "data": "grouping", "defaultContent": "" },
                //         { "data": "refferal", "defaultContent": "" },
                //         { "data": "fileNo", "defaultContent": "" },
