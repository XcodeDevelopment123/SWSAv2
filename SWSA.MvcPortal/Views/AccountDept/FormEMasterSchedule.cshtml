<h1>F1.6 Form E List</h1>

<div class="row">
    <div class="col-md-12">
        <div id="alertContainer"></div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-tasks me-2"></i>Form E Master Schedule Records
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#taskModal" id="addNewBtn">
                        <i class="fas fa-plus me-2"></i>New Record
                    </button>
                </div>
            </div>
            <!-- /.card-header -->
            <div class="card-body">
                <table id="taskDatatable" class="table table-bordered table-striped text-center w-100">
                    <thead>
                        <!-- 第一行：大类分组 (3 + 1 + 8 + 1 = 13列) -->
                        <tr class="text-center">
                            <th colspan="3">Admin</th>
                            <th>Tax Reference</th>
                            <th colspan="8">Login Info</th>
                            <th rowspan="2" style="vertical-align: middle;">Actions</th>
                        </tr>

                        <!-- 第二行：12 个明细列名 + 第 13 列由第一行 Actions 垂直合并 -->
                        <tr class="text-center">
                            <th>Grouping</th>
                            <th>Referral</th>
                            <th>Co Name</th>
                            <th>E number</th>
                            <th>Login</th>
                            <th>Password</th>
                            <th>Remark</th>
                            <th>Year to do</th>
                            <th>Date Doc In</th>
                            <th>Staff</th>
                            <th>Allocate to Wk Sch</th>
                            <th>Completed/Backlog</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

