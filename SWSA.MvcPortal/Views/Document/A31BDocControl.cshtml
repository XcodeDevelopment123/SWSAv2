@{
    ViewData["Title"] = "A31BDocControl";
}

<style>
    .dt-button-collection {
        max-height: 350px;
        overflow-y: auto;
        overscroll-behavior: contain;
    }
</style>

<h1>C1.2 Acc Dept Inbound / Outbound</h1>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-tasks me-2"></i>Document Control Records
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#taskModal">
                        <i class="fas fa-plus me-2"></i>New Record
                    </button>
                </div>
            </div>
            <div class="card-body table-responsive" style="overflow:auto">
                <table id="taskDatatable" class="table table-bordered table-striped w-100">
                    <thead>
                        <tr>
                            <th colspan="9">Receipt of Documents</th>
                            <th colspan="5">Return of Documents</th>
                            <th></th>
                        </tr>
                        <tr>
                            <th>Grouping</th>
                            <th>Client</th>
                            <th>Co Types</th>
                            <th>Year End</th>
                            <th>Date Received</th>
                            <th>Metrics</th>
                            <th># of bags/box</th>
                            <th>By Whom</th>
                            <th>Upload letter</th>
                            <th>Remark</th>
                            <th>Date</th>
                            <th># of bags/box</th>
                            <th>By Whom</th>
                            <th>Upload letter</th>
                            <th>Remark</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="recordsTableBody">
                        <!-- Records will be loaded dynamically via DataTable -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskModalLabel">
                    <i class="fas fa-edit me-2"></i>
                    <span id="modalTitle">Add Inbound / Outbound</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="taskForm">
                    <input type="hidden" id="editId" value="">

                    <!-- Basic Information -->
                    <div class="form-info-label col-12">
                        <label>Basic Information</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="clientId">Client (Link From Client List)</label>
                                <select id="clientId" name="clientId" class="form-control" required>
                                    <option value="">Select Client</option>
                                    <!-- Clients will be loaded dynamically -->
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="yearEndMonth">Year End</label>
                                <select id="yearEndMonth" name="yearEndMonth" class="form-control" required>
                                    <option value="">Select Month</option>
                                    <option value="Jan">Jan</option>
                                    <option value="Feb">Feb</option>
                                    <option value="Mar">Mar</option>
                                    <option value="Apr">Apr</option>
                                    <option value="May">May</option>
                                    <option value="Jun">Jun</option>
                                    <option value="Jul">Jul</option>
                                    <option value="Aug">Aug</option>
                                    <option value="Sept">Sept</option>
                                    <option value="Oct">Oct</option>
                                    <option value="Nov">Nov</option>
                                    <option value="Dec">Dec</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label for="yearSelect">Years</label>
                                <input type="text" id="yearSelect" name="yearSelect" class="form-control" placeholder="Select or type year" list="yearsList" required />
                                <datalist id="yearsList"></datalist>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="grouping">Grouping</label>
                                <input type="text" id="grouping" name="grouping" class="form-control" placeholder="Auto Fill" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="coStatus">Co Type</label>
                                <select id="coStatus" name="coStatus" class="form-control" required>
                                    <option value="">Select Type</option>
                                    <option value="Sdn Bhd">Sdn Bhd</option>
                                    <option value="LLP">LLP</option>
                                    <option value="Enterprise">Enterprise</option>
                                    <option value="Advocate">Advocate</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Receipt of Documents -->
                    <div class="form-info-label col-12">
                        <label>Receipt of Documents</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="dateReceived">Date Received</label>
                                <input type="text" id="dateReceived" name="dateReceived" class="form-control datepicker" placeholder="Select date" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="noOfBoxBag"># of bags/box</label>
                                <input type="number" id="noOfBoxBag" name="noOfBoxBag" class="form-control" placeholder="Enter number" min="0" />
                            </div>
                        </div>
                    </div>

                    <!-- Acknowledgement -->
                    <div class="form-info-label col-12">
                        <label>Acknowledgement</label>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="byWhom">By Whom</label>
                                <select id="byWhom" name="byWhom" class="form-control">
                                    <option value="">Select Staff</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="uploadLetter">Upload letter</label>
                                <div class="input-group">
                                    <input type="text" id="uploadLetter" name="uploadLetter" class="form-control" placeholder="Select status or attach letter" />
                                    <input type="file" id="uploadLetterFile" class="d-none" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="$('#uploadLetterFile').click()"><i class="fas fa-paperclip me-1"></i>Attach</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="metric">Metrics (No. of days)</label>
                                <input type="text" id="metric" name="metric" class="form-control" placeholder="Auto Calculate" readonly />
                                <small class="text-muted">Target doc inward = Year End + 5 mths (150 days)</small>
                            </div>
                        </div>
                    </div>

                    <!-- Receipt Remark -->
                    <div class="form-info-label col-12">
                        <label>Receipt Remark</label>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label for="remark">Remark</label>
                                <textarea id="remark" name="remark" class="form-control" placeholder="Enter remarks" rows="3"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Return of Documents -->
                    <div class="form-info-label col-12">
                        <label>Return of Documents</label>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="date">Date</label>
                                <input type="text" id="date" name="date" class="form-control datepicker" placeholder="Select date" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="noOfbox"># of bags/box</label>
                                <input type="number" id="noOfbox" name="noOfbox" class="form-control" placeholder="Enter number" min="0" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="byWhom2">By Whom</label>
                                <select id="byWhom2" name="byWhom2" class="form-control">
                                    <option value="">Select Staff</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="uploadLetter2">Upload letter</label>
                                <div class="input-group">
                                    <input type="text" id="uploadLetter2" name="uploadLetter2" class="form-control" placeholder="Select status or attach letter" />
                                    <input type="file" id="uploadLetter2File" class="d-none" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />
                                    <button class="btn btn-outline-secondary" type="button" onclick="$('#uploadLetter2File').click()"><i class="fas fa-paperclip me-1"></i>Attach</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="remark2">Return Remark</label>
                                <textarea id="remark2" name="remark2" class="form-control" placeholder="Enter return remarks" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" id="saveBtn">
                    <i class="fas fa-save me-2"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <!-- DataTables CSS + JS (with Buttons extension) -->
    <partial name="_DatatablesScriptsPartial" />

    <!-- Datepicker CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css">

    <!-- Datepicker JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>

    <script>
        let dataTable;
        let dataTableInitialized = false;

        $(document).ready(function() {
            // Initialize DataTable with Buttons toolbar (Copy/CSV/Excel/PDF/Print/Column visibility)
            try {
                dataTable = $('#taskDatatable').DataTable({
                    responsive: false,
                    ordering: true,
                    autoWidth: false,
                    pageLength: 10,
                    lengthChange: false,
                    dom: '<"d-flex justify-content-between align-items-center mb-2"Bf>rtip',
                    buttons: ["copy", "csv", "excel", "pdf", "print", "colvis"],
                    language: {
                        search: "Search:",
                        emptyTable: "No records found. Click \"New Record\" to create one.",
                        info: "Showing _START_ to _END_ of _TOTAL_ entries",
                        infoEmpty: "Showing 0 to 0 of 0 entries",
                        paginate: { first: "First", last: "Last", next: "Next", previous: "Previous" }
                    },
                    columnDefs: [
                        { targets: '_all', defaultContent: '' },
                        { targets: -1, orderable: false, searchable: false }
                    ],
                    scrollX: true
                });
                dataTableInitialized = true;
            } catch (error) {
                console.error('DataTable initialization error:', error);
                dataTableInitialized = false;
            }

            // Load records, clients, staff list, and initialize year dropdown on page load
            initYearDropdown();
            loadA31BRecords();
            loadClients();
            loadStaffUsers();

            // Initialize datepicker & calculate metrics on change
            $('.datepicker').datepicker({
                format: 'dd/mm/yyyy',
                autoclose: true
            }).on('changeDate change', function() {
                calculateMetrics();
            });

            // Recalculate metrics when year end changes
            $('#yearEndMonth, #yearSelect').on('change input', function() {
                calculateMetrics();
            });

            // File upload handlers
            $('#uploadLetterFile').change(function() { handleFileUpload('uploadLetterFile', 'uploadLetter'); });
            $('#uploadLetter2File').change(function() { handleFileUpload('uploadLetter2File', 'uploadLetter2'); });

            // Client selection change event
            $('#clientId').change(function() {
                var selectedClientId = $(this).val();
                if (selectedClientId) {
                    loadClientDetails(selectedClientId);
                } else {
                    $('#yearEndMonth').val('');
                    $('#grouping').val('');
                    calculateMetrics();
                }
            });

            // Save button click event
            $('#saveBtn').click(function() {
                saveA31BRecord();
            });

            // Form reset when modal is closed
            $('#taskModal').on('hidden.bs.modal', function () {
                $('#taskForm')[0].reset();
                $('#editId').val('');
                $('#modalTitle').text('Add Inbound / Outbound');
                $('#metric').val('');
                $('#grouping').val('');
            });
        });

        // Initialize Year Datalist (allows +- 10 years plus manual entry)
        function initYearDropdown() {
            var currentYear = new Date().getFullYear();
            var $list = $('#yearsList');
            $list.empty();
            for (var y = currentYear - 10; y <= currentYear + 10; y++) {
                $list.append('<option value="' + y + '">');
            }
        }

        // Load Staff Users for By Whom dropdowns
        function loadStaffUsers() {
            $.ajax({
                url: '/users/pic',
                type: 'GET',
                success: function(res) {
                    const users = Array.isArray(res) ? res : (res?.data || []);
                    const $byWhomSelect = $('#byWhom');
                    const $byWhom2Select = $('#byWhom2');

                    $byWhomSelect.find('option:not(:first)').remove();
                    $byWhom2Select.find('option:not(:first)').remove();

                    users.forEach(user => {
                        const val = user.name || user.Name || '';
                        if (val) {
                            $byWhomSelect.append(`<option value="${val}">${val}</option>`);
                            $byWhom2Select.append(`<option value="${val}">${val}</option>`);
                        }
                    });
                },
                error: function(err) {
                    console.error('Error loading users:', err);
                }
            });
        }

        // Handle File Upload via AJAX
        function handleFileUpload(fileInputId, textInputId) {
            var fileInput = $('#' + fileInputId)[0];
            if (fileInput.files && fileInput.files[0]) {
                var formData = new FormData();
                formData.append('file', fileInput.files[0]);

                $.ajax({
                    url: '/documents/upload-letter',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function(res) {
                        if (res.success) {
                            $('#' + textInputId).val(res.url);
                            showSuccess('Letter attached successfully!');
                        } else {
                            showError('Upload failed: ' + res.message);
                        }
                    },
                    error: function(err) {
                        showError('Upload failed');
                    }
                });
            }
        }

        // Helper to parse date string in dd/mm/yyyy or yyyy-mm-dd format
        function parseDateString(dateStr) {
            if (!dateStr) return null;
            if (dateStr.indexOf('/') !== -1) {
                var parts = dateStr.split('/');
                if (parts.length === 3) {
                    var d = parseInt(parts[0], 10);
                    var m = parseInt(parts[1], 10) - 1;
                    var y = parseInt(parts[2], 10);
                    return new Date(y, m, d);
                }
            } else if (dateStr.indexOf('-') !== -1) {
                var parts = dateStr.split('-');
                if (parts.length === 3) {
                    if (parts[0].length === 4) {
                        return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
                    } else {
                        return new Date(parseInt(parts[2], 10), parseInt(parts[1], 10) - 1, parseInt(parts[0], 10));
                    }
                }
            }
            return null;
        }

        // Helper to get last day of a month
        function getLastDayOfMonth(year, monthIdx) {
            return new Date(year, monthIdx + 1, 0);
        }

        const monthMap = {
            'jan': 0, 'january': 0, 'feb': 1, 'february': 1, 'mar': 2, 'march': 2,
            'apr': 3, 'april': 3, 'may': 4, 'jun': 5, 'june': 5,
            'jul': 6, 'july': 6, 'aug': 7, 'august': 7, 'sep': 8, 'sept': 8, 'september': 8,
            'oct': 9, 'october': 9, 'nov': 10, 'november': 10, 'dec': 11, 'december': 11
        };

        // Calculate Metrics based on Note 5:
        // Target doc inward = YearEnd + 5 mths (150 days)
        // Diff = (DateReceived - YearEnd in days) - 150 days
        function calculateMetricsValue(yearEndedStr, dateReceivedStr) {
            if (!yearEndedStr || !dateReceivedStr) return '';

            var recDate = parseDateString(dateReceivedStr);
            if (!recDate || isNaN(recDate.getTime())) return '';

            // Parse YearEnded
            var yeDate = null;
            if (yearEndedStr.indexOf('-') !== -1 || yearEndedStr.indexOf('/') !== -1) {
                yeDate = parseDateString(yearEndedStr);
            }

            if (!yeDate || isNaN(yeDate.getTime())) {
                var parts = yearEndedStr.trim().split(/\s+/);
                var monthIdx = 11;
                var yearVal = new Date().getFullYear();

                if (parts.length >= 2) {
                    var mStr = parts[0].toLowerCase();
                    if (monthMap.hasOwnProperty(mStr)) {
                        monthIdx = monthMap[mStr];
                    }
                    var yNum = parseInt(parts[1], 10);
                    if (!isNaN(yNum)) yearVal = yNum;
                } else if (parts.length === 1) {
                    var p = parts[0].toLowerCase();
                    if (monthMap.hasOwnProperty(p)) {
                        monthIdx = monthMap[p];
                    } else {
                        var yNum = parseInt(p, 10);
                        if (!isNaN(yNum)) yearVal = yNum;
                    }
                }
                yeDate = getLastDayOfMonth(yearVal, monthIdx);
            }

            if (!yeDate || isNaN(yeDate.getTime())) return '';

            var diffDaysFromYE = Math.floor((recDate.getTime() - yeDate.getTime()) / (1000 * 3600 * 24));
            var varianceDays = diffDaysFromYE - 150;

            if (varianceDays > 0) {
                return '+' + varianceDays + ' days';
            } else if (varianceDays < 0) {
                return varianceDays + ' days';
            } else {
                return '0 days';
            }
        }

        // Calculate Metrics for Form
        function calculateMetrics() {
            var dateRecStr = $('#dateReceived').val();
            var m = $('#yearEndMonth').val() || '';
            var y = $('#yearSelect').val() || '';
            var yearEndedVal = (m && y) ? (m + ' ' + y) : (m || y);

            var metricVal = calculateMetricsValue(yearEndedVal, dateRecStr);
            $('#metric').val(metricVal);
        }

        // Load clients from database
        function loadClients() {
            $.ajax({
                url: '/clients/selections?type=SdnBhd&type=LLP&type=Enterprise&type=Individual',
                type: 'GET',
                success: function(response) {
                    var clientList = Array.isArray(response) ? response : (response && response.data ? response.data : []);
                    if (clientList.length > 0) {
                        populateClientDropdown(clientList);
                    } else {
                        fetchClientsFallback();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading clients selections:', error);
                    fetchClientsFallback();
                }
            });
        }

        function fetchClientsFallback() {
            $.ajax({
                url: '/documents/get-clients',
                type: 'GET',
                success: function(response) {
                    if (response && response.success && response.data) {
                        populateClientDropdown(response.data);
                    }
                }
            });
        }

        // Load client details including year end and grouping
        function loadClientDetails(clientId) {
            $.ajax({
                url: '/documents/get-client-details/' + clientId,
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        // Auto-fill grouping
                        if (response.data.group) {
                            $('#grouping').val(response.data.group);
                        }

                        // Auto-fill year end based on client's YearEndMonth
                        if (response.data.yearEndMonth) {
                            var monthName = getMonthName(response.data.yearEndMonth);
                            $('#yearEndMonth').val(monthName);
                            if (!$('#yearSelect').val()) {
                                $('#yearSelect').val(new Date().getFullYear());
                            }
                        }

                        // Auto-fill Co Type if available
                        if (response.data.clientType) {
                            if (response.data.clientType === 1 || response.data.clientType === 'SdnBhd') {
                                $('#coStatus').val('Sdn Bhd');
                            } else if (response.data.clientType === 2 || response.data.clientType === 'LLP') {
                                $('#coStatus').val('LLP');
                            } else if (response.data.clientType === 3 || response.data.clientType === 'Enterprise') {
                                $('#coStatus').val('Enterprise');
                            }
                        }

                        calculateMetrics();
                    } else {
                        console.error('Failed to load client details:', response.message);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading client details:', error);
                }
            });
        }

        // Helper function to convert month number to month name
        function getMonthName(monthNumber) {
            const months = [
                'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
            ];
            return months[monthNumber - 1] || 'Dec';
        }

        // Populate client dropdown
        function populateClientDropdown(clients) {
            var dropdown = $('#clientId');
            dropdown.empty();
            dropdown.append('<option value="">Select Client</option>');

            if (clients && clients.length > 0) {
                clients.forEach(function(client) {
                    var cid = client.id !== undefined ? client.id : (client.clientId !== undefined ? client.clientId : (client.Id !== undefined ? client.Id : client.ClientId));
                    var cname = client.name || client.Name || client.companyName || client.CompanyName;
                    if (cid !== undefined && cname) {
                        dropdown.append('<option value="' + cid + '">' + cname + '</option>');
                    }
                });
            } else {
                dropdown.append('<option value="" disabled>No clients available</option>');
            }
        }

        // Load A31B records from database
        function loadA31BRecords() {
            $.ajax({
                url: '/documents/get-a31b-records',
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        populateTable(response.data);
                    } else {
                        console.error('Failed to load records:', response.message);
                        showError('Failed to load records: ' + response.message);
                        if (!dataTableInitialized) {
                            $('#recordsTableBody').html('<tr><td colspan="16" class="text-center text-muted py-4">Error loading records</td></tr>');
                        }
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading records:', error);
                    showError('Error loading records: ' + error);
                    if (!dataTableInitialized) {
                        $('#recordsTableBody').html('<tr><td colspan="16" class="text-center text-muted py-4">Error loading records</td></tr>');
                    }
                }
            });
        }

        function formatUploadLetter(val) {
            if (!val) return 'N/A';
            if (val.indexOf('/uploads/') !== -1) {
                return '<a href="' + val + '" target="_blank" class="btn btn-xs btn-outline-info text-nowrap"><i class="fas fa-file-alt me-1"></i>View Letter</a>';
            }
            return val;
        }

        // Populate table with records (via DataTable API so Buttons/Search work correctly)
        function populateTable(records) {
            if (!dataTableInitialized) {
                manualPopulateTable(records);
                return;
            }

            dataTable.clear();

            if (records && records.length > 0) {
                records.forEach(function(record) {
                    var metricDisplay = calculateMetricsValue(record.yearEnded, record.dateReceived) || 'N/A';

                    dataTable.row.add([
                        record.grouping || 'N/A',
                        record.clients || 'N/A',
                        record.coStatus || 'N/A',
                        record.yearEnded || 'N/A',
                        record.dateReceived || 'N/A',
                        metricDisplay,
                        record.noOfBoxBag != null ? record.noOfBoxBag : 'N/A',
                        record.byWhom || 'N/A',
                        formatUploadLetter(record.uploadLetter),
                        record.remark || 'N/A',
                        record.date || 'N/A',
                        record.noOfbox != null ? record.noOfbox : 'N/A',
                        record.byWhom2 || 'N/A',
                        formatUploadLetter(record.uploadLetter2),
                        record.remark2 || 'N/A',
                        '<button class="btn btn-sm btn-warning me-1 edit-btn" data-id="' + record.id + '" title="Edit"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn btn-sm btn-danger delete-btn" data-id="' + record.id + '" title="Delete"><i class="fas fa-trash"></i></button>'
                    ]);
                });
            }

            dataTable.draw();
        }

        // Fallback manual population if DataTable failed to initialize
        function manualPopulateTable(records) {
            var tbody = $('#recordsTableBody');
            tbody.empty();

            if (!records || records.length === 0) {
                tbody.append('<tr><td colspan="16" class="text-center text-muted py-4">No records found. Click "New Record" to create one.</td></tr>');
                return;
            }

            records.forEach(function(record) {
                var metricDisplay = calculateMetricsValue(record.yearEnded, record.dateReceived) || 'N/A';

                var row = '<tr>' +
                    '<td>' + (record.grouping || 'N/A') + '</td>' +
                    '<td>' + (record.clients || 'N/A') + '</td>' +
                    '<td>' + (record.coStatus || 'N/A') + '</td>' +
                    '<td>' + (record.yearEnded || 'N/A') + '</td>' +
                    '<td>' + (record.dateReceived || 'N/A') + '</td>' +
                    '<td>' + metricDisplay + '</td>' +
                    '<td>' + (record.noOfBoxBag != null ? record.noOfBoxBag : 'N/A') + '</td>' +
                    '<td>' + (record.byWhom || 'N/A') + '</td>' +
                    '<td>' + formatUploadLetter(record.uploadLetter) + '</td>' +
                    '<td>' + (record.remark || 'N/A') + '</td>' +
                    '<td>' + (record.date || 'N/A') + '</td>' +
                    '<td>' + (record.noOfbox != null ? record.noOfbox : 'N/A') + '</td>' +
                    '<td>' + (record.byWhom2 || 'N/A') + '</td>' +
                    '<td>' + formatUploadLetter(record.uploadLetter2) + '</td>' +
                    '<td>' + (record.remark2 || 'N/A') + '</td>' +
                    '<td class="text-nowrap">' +
                    '<button class="btn btn-sm btn-warning me-1" onclick="editRecord(' + record.id + ')" title="Edit">' +
                    '<i class="fas fa-edit"></i>' +
                    '</button>' +
                    '<button class="btn btn-sm btn-danger" onclick="deleteRecord(' + record.id + ')" title="Delete">' +
                    '<i class="fas fa-trash"></i>' +
                    '</button>' +
                    '</td>' +
                    '</tr>';

                tbody.append(row);
            });
        }

        // Delegate Edit/Delete button clicks (works for both DataTable-drawn and manual rows)
        $(document).on('click', '.edit-btn', function() {
            editRecord($(this).data('id'));
        });
        $(document).on('click', '.delete-btn', function() {
            deleteRecord($(this).data('id'));
        });

        // Save A31B record
        function saveA31BRecord() {
            var selectedClientId = $('#clientId').val();
            var selectedClientName = $('#clientId option:selected').text();

            var m = $('#yearEndMonth').val() || '';
            var y = $('#yearSelect').val() || '';
            var yearEndedVal = (m && y) ? (m + ' ' + y) : (m || y);

            var formData = {
                Id: $('#editId').val() ? parseInt($('#editId').val()) : 0,
                Clients: selectedClientName,
                YearEnded: yearEndedVal,
                CoStatus: $('#coStatus').val(),
                DateReceived: $('#dateReceived').val(),
                NoOfBoxBag: $('#noOfBoxBag').val() ? parseInt($('#noOfBoxBag').val()) : null,
                ByWhom: $('#byWhom').val(),
                UploadLetter: $('#uploadLetter').val(),
                Remark: $('#remark').val(),
                Date: $('#date').val(),
                NoOfbox: $('#noOfbox').val() ? parseInt($('#noOfbox').val()) : null,
                ByWhom2: $('#byWhom2').val(),
                UploadLetter2: $('#uploadLetter2').val(),
                Remark2: $('#remark2').val()
            };

            // Validate required fields
            if (!formData.Clients || formData.Clients === 'Select Client') {
                alert('Please select a client from the dropdown');
                return;
            }

            if (!formData.YearEnded) {
                alert('Please ensure Year End is filled (it should auto-fill when client is selected)');
                return;
            }

            if (!formData.CoStatus) {
                alert('Please select Company Type');
                return;
            }

            // Show loading
            $('#saveBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Saving...');

            // Determine HTTP method based on Id
            const isUpdate = formData.Id > 0;
            const url = isUpdate ? '/documents/update-a31b' : '/documents/create-a31b';
            const method = isUpdate ? 'PUT' : 'POST';

            console.log('Making ' + method + ' request to: ' + url);

            $.ajax({
                url: url,
                type: method,
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    $('#saveBtn').prop('disabled', false).html('<i class="fas fa-save me-2"></i>Save');

                    if (response.success) {
                        $('#taskModal').modal('hide');
                        showSuccess('Record saved successfully!');
                        loadA31BRecords();
                    } else {
                        showError('Save failed: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    $('#saveBtn').prop('disabled', false).html('<i class="fas fa-save me-2"></i>Save');
                    console.error('Save error:', error);
                    console.error('XHR status:', xhr.status);
                    console.error('XHR response:', xhr.responseText);

                    let errorMessage = 'Error during save: ' + error;
                    if (xhr.responseText) {
                        try {
                            const errorResponse = JSON.parse(xhr.responseText);
                            if (errorResponse.message) {
                                errorMessage = errorResponse.message;
                            }
                        } catch (e) {
                            errorMessage = xhr.responseText;
                        }
                    }

                    showError(errorMessage);
                }
            });
        }

        // Edit record
        function editRecord(id) {
            $.ajax({
                url: '/documents/get-a31b-record/' + id,
                type: 'GET',
                success: function(response) {
                    if (response.success) {
                        var record = response.data;
                        $('#editId').val(record.id);

                        // Set client value
                        var clientDropdown = $('#clientId');
                        var clientExists = false;

                        if (record.clients) {
                            clientDropdown.find('option').each(function() {
                                if ($(this).text() === record.clients) {
                                    clientExists = true;
                                    $(this).prop('selected', true);
                                    loadClientDetails($(this).val());
                                    return false;
                                }
                            });
                        }

                        if (record.yearEnded) {
                            var parts = record.yearEnded.split(' ');
                            if (parts.length >= 2) {
                                var lastPart = parts[parts.length - 1];
                                if (/^\d{4}$/.test(lastPart)) {
                                    $('#yearSelect').val(lastPart);
                                    $('#yearEndMonth').val(parts[parts.length - 2]);
                                } else {
                                    $('#yearEndMonth').val(parts[0]);
                                }
                            } else {
                                $('#yearEndMonth').val(record.yearEnded);
                            }
                        }

                        if (record.grouping) {
                            $('#grouping').val(record.grouping);
                        }

                        $('#coStatus').val(record.coStatus);
                        $('#dateReceived').val(record.dateReceived);
                        $('#noOfBoxBag').val(record.noOfBoxBag);
                        $('#byWhom').val(record.byWhom);
                        $('#uploadLetter').val(record.uploadLetter);
                        $('#remark').val(record.remark);
                        $('#date').val(record.date);
                        $('#noOfbox').val(record.noOfbox);
                        $('#byWhom2').val(record.byWhom2);
                        $('#uploadLetter2').val(record.uploadLetter2);
                        $('#remark2').val(record.remark2);

                        calculateMetrics();

                        $('#modalTitle').text('Edit Inbound / Outbound Record');
                        $('#taskModal').modal('show');
                    } else {
                        showError('Failed to load record: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    showError('Error loading record: ' + error);
                }
            });
        }

        // Delete record
        function deleteRecord(id) {
            if (confirm('Are you sure you want to delete this record? This action cannot be undone.')) {
                $.ajax({
                    url: '/documents/delete-a31b/' + id,
                    type: 'DELETE',
                    success: function(response) {
                        if (response.success) {
                            showSuccess('Record deleted successfully!');
                            loadA31BRecords();
                        } else {
                            showError('Delete failed: ' + response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        showError('Error during delete: ' + error);
                    }
                });
            }
        }

        // Utility functions
        function showSuccess(message) {
            alert('✅ ' + message);
        }

        function showError(message) {
            alert('❌ ' + message);
        }
    </script>
}
